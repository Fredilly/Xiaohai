# 生产环境仅使用密钥管理系统注入的真实值，禁止复制开发凭据。
# Inject real production values through the secret manager only; never copy development credentials.
NODE_ENV=production
APP_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://PRODUCTION_USER:PRODUCTION_PASSWORD@PRODUCTION_HOST:5432/PRODUCTION_DATABASE
REDIS_URL=redis://PRODUCTION_REDIS_HOST:6379
AI_PROVIDER=DEEPSEEK
AI_MOCK_ENABLED=false
DEEPSEEK_API_KEY=INJECT_FROM_PRODUCTION_SECRET_MANAGER
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_WORKER_POLL_MS=1000
STORY_AI_ENABLED=false
STORY_AI_PROVIDER=DEEPSEEK
STORY_AI_MODEL=INJECT_APPROVED_STORY_MODEL
STORY_AI_MAX_ATTEMPTS=3
STORY_AI_TIMEOUT_MS=30000
PICTURE_BOOK_AI_ENABLED=false
PICTURE_BOOK_AI_PROVIDER=DEEPSEEK
PICTURE_BOOK_AI_MODEL=INJECT_APPROVED_PICTURE_BOOK_TEXT_MODEL
PICTURE_BOOK_AI_MAX_ATTEMPTS=3
PICTURE_BOOK_AI_TIMEOUT_MS=30000
ANIMATION_AI_ENABLED=false
ANIMATION_AI_PROVIDER=DEEPSEEK
ANIMATION_AI_MODEL=INJECT_APPROVED_ANIMATION_TEXT_MODEL
ANIMATION_AI_MAX_ATTEMPTS=3
ANIMATION_AI_TIMEOUT_MS=30000
ANIMATION_VIDEO_ENABLED=false
ANIMATION_VIDEO_PROVIDER=MOCK
ANIMATION_VIDEO_MODEL=NO_PRODUCTION_VIDEO_PROVIDER_SELECTED
ANIMATION_VIDEO_TIMEOUT_MS=30000
ANIMATION_MAX_GENERATIONS=100
ANIMATION_MAX_COMPOSITIONS=10
ANIMATION_MAX_PLANNED_DURATION_MS=600000
ANIMATION_COMPOSITION_ENABLED=false
ANIMATION_COMPOSITION_PROVIDER=MOCK
ANIMATION_COMPOSITION_TIMEOUT_MS=30000
PICTURE_BOOK_IMAGE_ENABLED=false
PICTURE_BOOK_IMAGE_PROVIDER=MOCK
PICTURE_BOOK_IMAGE_MODEL=NO_PRODUCTION_IMAGE_PROVIDER_SELECTED
PICTURE_BOOK_IMAGE_TIMEOUT_MS=30000
WECHAT_APP_ID=INJECT_FROM_PRODUCTION_SECRET_MANAGER
WECHAT_APP_SECRET=INJECT_FROM_PRODUCTION_SECRET_MANAGER
WECHAT_AUTH_TIMEOUT_MS=5000
CONSUMER_SESSION_SECRET=INJECT_FROM_PRODUCTION_SECRET_MANAGER_MINIMUM_32_CHARACTERS
CONSUMER_SESSION_TTL_SECONDS=604800
STAFF_SESSION_SECRET=INJECT_DISTINCT_PRODUCTION_SECRET_MANAGER_VALUE_MINIMUM_32_CHARACTERS
STAFF_SESSION_TTL_SECONDS=28800
VITE_API_BASE_URL=https://PRODUCTION_API_DOMAIN
WECHAT_PAY_ENABLED=false
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_SERIAL=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_KEY_ID=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
WECHAT_PAY_NOTIFY_URL=https://payments.example.invalid/api/v1/payments/wechat/notify
WECHAT_PAY_REFUND_NOTIFY_URL=https://payments.example.invalid/api/v1/payments/wechat/notify
