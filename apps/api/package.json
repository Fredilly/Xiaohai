{
  "name": "@xiaohai/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "predev": "[ -f ../../.env ] || cp ../../.env.example ../../.env",
    "dev": "node --env-file ../../.env --conditions=development --import tsx/esm --watch src/server.ts",
    "finance:backfill": "node --env-file ../../.env --conditions=development --import tsx/esm src/finance/backfill.ts",
    "seed:local-staff": "node --env-file ../../.env --conditions=development --import tsx/esm src/dev/seed-local-staff-cli.ts",
    "lint": "eslint src test",
    "start": "node dist/server.js",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xiaohai/config": "workspace:*",
    "@xiaohai/contracts": "workspace:*",
    "@xiaohai/db": "workspace:*",
    "@xiaohai/domain": "workspace:*",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "pino": "catalog:",
    "redis": "^5.12.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
