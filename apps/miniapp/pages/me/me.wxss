.me-page {
  min-height: 100vh;
  background: #f6f6f8;
  padding-bottom: 44rpx;
}

.profile-hero {
  position: relative;
  overflow: hidden;
  padding: 30rpx 30rpx 40rpx;
  background: linear-gradient(135deg, #ff4c93 0%, #ff5ca1 45%, #4c8dff 130%);
  color: #fff;
}

.hero-orb {
  position: absolute;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
}

.hero-orb-one {
  width: 360rpx;
  height: 360rpx;
  right: -120rpx;
  top: -80rpx;
}

.hero-orb-two {
  width: 180rpx;
  height: 180rpx;
  left: -90rpx;
  bottom: -70rpx;
}

.profile-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.avatar-button {
  width: 118rpx;
  height: 118rpx;
  padding: 0;
  margin: 0;
  border-radius: 999rpx;
  overflow: hidden;
  background: #fff;
  border: 6rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 10rpx 28rpx rgba(117, 36, 89, 0.16);
}

.avatar-button::after {
  border: 0;
}

.avatar-image,
.avatar-fallback {
  width: 100%;
  height: 100%;
  border-radius: 999rpx;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  color: #025a7e;
  font-size: 44rpx;
  font-weight: 800;
}

.profile-copy {
  flex: 1;
  min-width: 0;
}

.profile-name {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
}

.profile-status,
.profile-id {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.4;
}

.profile-setting {
  width: 62rpx;
  height: 62rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.32);
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
}

.login-button {
  position: relative;
  z-index: 1;
  margin: 24rpx 0 0 140rpx;
  width: 220rpx;
  height: 66rpx;
  line-height: 66rpx;
  border: 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  color: #ff3f8d;
  font-size: 25rpx;
  font-weight: 800;
}

.login-button::after {
  border: 0;
}

.profile-stats {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 34rpx;
}

.profile-stat {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.profile-stat + .profile-stat::before {
  content: '';
  position: absolute;
  left: 0;
  top: 18rpx;
  width: 1rpx;
  height: 50rpx;
  background: rgba(255, 255, 255, 0.28);
}

.stat-value {
  font-size: 34rpx;
  font-weight: 800;
}

.stat-label {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.86);
}

.content-shell {
  padding: 24rpx;
}

.me-card {
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 28rpx rgba(32, 35, 40, 0.05);
}

.order-card,
.service-card {
  padding: 28rpx 26rpx;
}

.service-card {
  margin-top: 22rpx;
}

.card-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-heading-title {
  font-size: 31rpx;
  font-weight: 800;
  color: #222;
}

.card-heading-link {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: #878787;
  font-size: 23rpx;
}

.chevron {
  font-size: 34rpx;
  line-height: 1;
}

.order-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  margin-top: 30rpx;
}

.order-item,
.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.order-icon {
  width: 66rpx;
  height: 58rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff0f6;
  color: #ff3f8d;
  font-size: 24rpx;
  font-weight: 900;
}

.order-title {
  margin-top: 14rpx;
  color: #363636;
  font-size: 21rpx;
  text-align: center;
  white-space: nowrap;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  row-gap: 34rpx;
  margin-top: 32rpx;
}

.service-icon {
  width: 74rpx;
  height: 74rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 25rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 20rpx rgba(20, 28, 44, 0.1);
}

.tone-blue {
  background: linear-gradient(135deg, #72b4ff, #4c8dff);
}

.tone-purple {
  background: linear-gradient(135deg, #c9a9ff, #8c62ef);
}

.tone-pink {
  background: linear-gradient(135deg, #ff8dbc, #ff4c93);
}

.tone-green {
  background: linear-gradient(135deg, #5cad7c, #146739);
}

.tone-orange {
  background: linear-gradient(135deg, #ffb56a, #ff7a43);
}

.tone-cyan {
  background: linear-gradient(135deg, #70e5e3, #30b8c5);
}

.tone-yellow {
  background: linear-gradient(135deg, #ffd86c, #f7ad25);
}

.tone-navy {
  background: linear-gradient(135deg, #3b86a9, #025a7e);
}

.service-title {
  margin-top: 13rpx;
  color: #383838;
  font-size: 22rpx;
  text-align: center;
  white-space: nowrap;
}

.experience-note {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin: 24rpx 10rpx 0;
  color: #999;
  font-size: 20rpx;
  line-height: 1.6;
}

.brand-dot {
  flex: 0 0 auto;
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  margin-top: 9rpx;
}

.brand-dot.pink {
  background: #ff4c93;
}
