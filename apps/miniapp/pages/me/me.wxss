/* #130 Stage 3: illustrated reader-passport structure with real consumer bindings. */
.me-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx 24rpx 85rpx;
  background: #fff9ef;
  color: #253f48;
}
.passport-hero {
  position: relative;
  overflow: hidden;
  padding: 30rpx 28rpx 25rpx;
  border: 1rpx solid #d7e9d8;
  border-radius: 34rpx;
  background: #e3f1e6;
}
.passport-art {
  position: absolute;
  top: -12rpx;
  right: -30rpx;
  width: 225rpx;
  height: 210rpx;
  opacity: 0.55;
}
.paper-leaf {
  position: absolute;
  width: 70rpx;
  height: 120rpx;
  border-radius: 95% 0 85% 8%;
  background: #9bc69e;
}
.leaf-one {
  top: 0;
  right: 20rpx;
  transform: rotate(-30deg);
}
.leaf-two {
  top: 60rpx;
  right: 110rpx;
  transform: rotate(-75deg);
}
.paper-book {
  position: absolute;
  top: 96rpx;
  right: 20rpx;
  display: flex;
  width: 150rpx;
  height: 80rpx;
  transform: rotate(-14deg);
}
.paper-page {
  box-sizing: border-box;
  flex: 1;
  border: 3rpx solid #53876a;
  background: #fff8df;
}
.paper-left {
  border-radius: 10rpx 2rpx 4rpx 9rpx;
  transform: skewY(6deg);
}
.paper-right {
  border-radius: 2rpx 10rpx 9rpx 4rpx;
  transform: skewY(-6deg);
}
.passport-kicker {
  position: relative;
  z-index: 1;
  display: block;
  margin-bottom: 21rpx;
  color: #4c8465;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.profile-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.avatar-button {
  box-sizing: border-box;
  flex: none;
  width: 102rpx;
  height: 102rpx;
  margin: 0;
  padding: 0;
  overflow: hidden;
  border: 4rpx solid #fff;
  border-radius: 27rpx;
  background: #fff;
}
.avatar-button::after,
.login-button::after {
  border: 0;
}
.avatar-image,
.avatar-fallback {
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  border-radius: 23rpx;
}
.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f8f7e9;
}
.avatar-symbol {
  width: 51rpx;
  height: 51rpx;
}
.profile-copy {
  flex: 1;
  min-width: 0;
}
.profile-name {
  display: block;
  color: #254d3a;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.4;
}
.profile-status,
.profile-id {
  display: block;
  margin-top: 7rpx;
  color: #4b6b58;
  font-size: 21rpx;
  line-height: 1.4;
  overflow-wrap: break-word;
}
.profile-setting {
  position: relative;
  z-index: 2;
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  border: 1rpx solid #c5dcc9;
  border-radius: 19rpx;
  background: rgba(255, 255, 255, 0.87);
}
.setting-symbol {
  width: 33rpx;
  height: 33rpx;
}
.login-button {
  position: relative;
  z-index: 1;
  width: 100%;
  min-height: 76rpx;
  margin: 23rpx 0 0;
  border: 0;
  border-radius: 19rpx;
  background: #287353;
  color: #fff;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 76rpx;
}
.login-button[disabled] {
  opacity: 0.56;
}
.passport-note {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 18rpx;
  color: #5d7763;
  font-size: 21rpx;
  line-height: 1.5;
}
.content-shell {
  padding-top: 20rpx;
}
.me-card {
  box-sizing: border-box;
  padding: 27rpx 24rpx;
  border: 1rpx solid #eee8de;
  border-radius: 29rpx;
  background: #fff;
  box-shadow: 0 7rpx 20rpx rgba(48, 77, 59, 0.035);
}
.service-card {
  margin-top: 20rpx;
}
.card-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.card-heading-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}
.section-kicker {
  color: #7e9c87;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.card-heading-title {
  color: #284d39;
  font-size: 30rpx;
  font-weight: 800;
}
.card-heading-link {
  display: flex;
  flex: none;
  align-items: center;
  gap: 6rpx;
  min-height: 65rpx;
  color: #437456;
  font-size: 22rpx;
}
.chevron {
  font-size: 32rpx;
}
.order-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 4rpx;
  margin-top: 22rpx;
}
.order-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 11rpx;
  min-width: 0;
  min-height: 119rpx;
}
.order-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: #fff0dc;
}
.tile-symbol {
  width: 34rpx;
  height: 34rpx;
}
.order-title {
  color: #4b5f50;
  font-size: 20rpx;
  line-height: 1.4;
  text-align: center;
  overflow-wrap: anywhere;
}
.service-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 24rpx 10rpx;
  margin-top: 25rpx;
}
.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 10rpx;
  min-width: 0;
  min-height: 116rpx;
}
.service-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  border-radius: 24rpx;
  background: #f3f5ec;
}
.service-icon.tone-blue,
.service-icon.tone-cyan {
  background: #e0eef2;
}
.service-icon.tone-purple,
.service-icon.tone-pink {
  background: #f1e5f0;
}
.service-icon.tone-green {
  background: #e4f2df;
}
.service-icon.tone-orange,
.service-icon.tone-yellow {
  background: #fff0d5;
}
.service-icon.tone-navy {
  background: #e8ede9;
}
.service-title {
  color: #475f4f;
  font-size: 21rpx;
  line-height: 1.4;
  text-align: center;
  overflow-wrap: anywhere;
}
.order-item:active,
.service-item:active,
.card-heading-link:active,
.profile-setting:active {
  opacity: 0.72;
}
.service-footer {
  display: block;
  padding: 20rpx 9rpx 0;
  color: #849183;
  font-size: 19rpx;
  line-height: 1.5;
  text-align: center;
}
