.me-page {
  min-height: 100vh;
  background: #f7f7fa;
  padding-bottom: 44rpx;
}

.profile-hero {
  position: relative;
  overflow: hidden;
  padding: 30rpx 30rpx 40rpx;
  background: linear-gradient(125deg, #dfe7f0 0%, #e1e3f0 52%, #d3e6ee 100%);
  color: #384654;
}

.hero-orb {
  position: absolute;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.24);
}

.hero-orb-one {
  width: 360rpx;
  height: 360rpx;
  right: -120rpx;
  top: -80rpx;
}

.hero-orb-two {
  width: 180rpx;
  height: 180rpx;
  left: -90rpx;
  bottom: -70rpx;
}

.profile-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.avatar-button {
  width: 118rpx;
  height: 118rpx;
  padding: 0;
  margin: 0;
  border-radius: 999rpx;
  overflow: hidden;
  background: #fff;
  border: 6rpx solid rgba(255, 255, 255, 0.78);
  box-shadow: 0 10rpx 26rpx rgba(92, 77, 108, 0.12);
}

.avatar-button::after {
  border: 0;
}

.avatar-image,
.avatar-fallback {
  width: 100%;
  height: 100%;
  border-radius: 999rpx;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  color: #60738a;
}

.avatar-symbol {
  width: 60rpx;
  height: 60rpx;
}
.setting-symbol {
  width: 35rpx;
  height: 35rpx;
}
.tile-symbol {
  width: 38rpx;
  height: 38rpx;
}

.profile-copy {
  flex: 1;
  min-width: 0;
}

.profile-name {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
}

.profile-status,
.profile-id {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #687887;
  line-height: 1.4;
}

.profile-setting {
  width: 62rpx;
  height: 62rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.58);
  border: 1rpx solid rgba(255, 255, 255, 0.7);
}

.login-button {
  position: relative;
  z-index: 1;
  margin: 24rpx 0 0 140rpx;
  width: 220rpx;
  height: 66rpx;
  line-height: 66rpx;
  border: 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  color: #8b6786;
  font-size: 25rpx;
  font-weight: 800;
}

.login-button::after {
  border: 0;
}

.profile-stats {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 34rpx;
}

.profile-stat {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.profile-stat + .profile-stat::before {
  content: '';
  position: absolute;
  left: 0;
  top: 18rpx;
  width: 1rpx;
  height: 50rpx;
  background: rgba(91, 108, 132, 0.18);
}

.stat-value {
  font-size: 34rpx;
  font-weight: 800;
}

.stat-label {
  font-size: 23rpx;
  color: #687887;
}

.content-shell {
  padding: 24rpx;
}

.me-card {
  background: #fff;
  border-radius: 28rpx;
  border: 1rpx solid #f0eef2;
  box-shadow: 0 10rpx 28rpx rgba(62, 58, 72, 0.045);
}

.order-card,
.service-card {
  padding: 28rpx 26rpx;
}

.service-card {
  margin-top: 22rpx;
}

.card-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-heading-title {
  font-size: 31rpx;
  font-weight: 800;
  color: #2f3035;
}

.card-heading-link {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: #92939a;
  font-size: 23rpx;
}

.chevron {
  font-size: 34rpx;
  line-height: 1;
}

.order-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  margin-top: 30rpx;
}

.order-item,
.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.order-icon {
  width: 66rpx;
  height: 58rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fae7ee;
  color: #c96f8e;
}

.order-title {
  margin-top: 14rpx;
  color: #45464b;
  font-size: 21rpx;
  text-align: center;
  white-space: nowrap;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  row-gap: 34rpx;
  margin-top: 32rpx;
}

.service-icon {
  width: 74rpx;
  height: 74rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 18rpx rgba(48, 52, 63, 0.07);
}

.tone-blue {
  background: #c7dbf2;
  color: #567aa2;
}

.tone-purple {
  background: #d9caec;
  color: #79649a;
}

.tone-pink {
  background: #f3c7d6;
  color: #a45f78;
}

.tone-green {
  background: #c9dfd0;
  color: #53775f;
}

.tone-orange {
  background: #f5d2b7;
  color: #a66d46;
}

.tone-cyan {
  background: #c3e4e2;
  color: #4b7d7b;
}

.tone-yellow {
  background: #f2dfb9;
  color: #94783e;
}

.tone-navy {
  background: #bdd6e1;
  color: #4e7180;
}

.service-title {
  margin-top: 13rpx;
  color: #45464b;
  font-size: 22rpx;
  text-align: center;
  white-space: nowrap;
}
