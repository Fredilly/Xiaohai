<view class="me-page">
  <view class="profile-hero">
    <view class="hero-orb hero-orb-one"></view>
    <view class="hero-orb hero-orb-two"></view>

    <view class="profile-row">
      <button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="chooseAvatar">
        <image wx:if="{{avatarUrl}}" class="avatar-image" src="{{avatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar-fallback"><image class="avatar-symbol" src="/assets/ui/user.svg" /></view>
      </button>

      <view class="profile-copy">
        <text class="profile-kicker">小海童话 · 阅读空间</text>
        <text class="profile-name">{{isLoggedIn ? '小海用户' : '欢迎来到小海'}}</text>
        <text class="profile-status">{{status}}</text>
        <text wx:if="{{isLoggedIn}}" class="profile-id">ID {{consumerDisplayId}}</text>
      </view>

      <view class="profile-setting" data-key="settings" bindtap="openFeature"><image class="setting-symbol" src="/assets/ui/settings.svg" /></view>
    </view>

    <button
      wx:if="{{!isLoggedIn}}"
      class="login-button"
      loading="{{isLoading}}"
      disabled="{{isLoading}}"
      bindtap="login"
    >
      微信登录
    </button>

    <view class="profile-caption">登录后查看订单、租借与创作内容</view>
  </view>

  <view class="content-shell">
    <view class="me-card order-card">
      <view class="card-heading">
        <text class="card-heading-title">订单中心</text>
        <view class="card-heading-link" data-key="orders" bindtap="openFeature">
          <text>查看全部</text>
          <text class="chevron">›</text>
        </view>
      </view>

      <view class="order-grid">
        <view
          class="order-item"
          wx:for="{{orderActions}}"
          wx:key="title"
          data-key="{{item.key}}"
          data-view="{{item.view}}"
          bindtap="openFeature"
        >
          <view class="order-icon"><image class="tile-symbol" src="/assets/ui/{{item.icon}}.svg" /></view>
          <text class="order-title">{{item.title}}</text>
        </view>
      </view>
    </view>

    <view class="me-card service-card">
      <view class="card-heading">
        <text class="card-heading-title">我的服务</text>
        <text class="card-heading-note">按需探索</text>
      </view>

      <view class="service-grid">
        <view
          class="service-item"
          wx:for="{{serviceTiles}}"
          wx:key="title"
          data-key="{{item.key}}"
          bindtap="openFeature"
        >
          <view class="service-icon tone-{{item.tone}}"><image class="tile-symbol" src="/assets/ui/{{item.icon}}.svg" /></view>
          <text class="service-title">{{item.title}}</text>
          <text wx:if="{{item.key === 'purchased' || item.key === 'member' || item.key === 'settings'}}" class="service-status">即将开放</text>
        </view>
      </view>
    </view>

  </view>
</view>
