<view class="me-page">
  <view class="profile-hero">
    <view class="hero-orb hero-orb-one"></view>
    <view class="hero-orb hero-orb-two"></view>

    <view class="profile-row">
      <button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="chooseAvatar">
        <image wx:if="{{avatarUrl}}" class="avatar-image" src="{{avatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar-fallback">海</view>
      </button>

      <view class="profile-copy">
        <text class="profile-name">{{isLoggedIn ? '小海用户' : '欢迎来到小海'}}</text>
        <text class="profile-status">{{status}}</text>
        <text wx:if="{{isLoggedIn}}" class="profile-id">ID {{consumerDisplayId}}</text>
      </view>

      <view class="profile-setting" data-key="settings" bindtap="openFeature">设</view>
    </view>

    <button
      wx:if="{{!isLoggedIn}}"
      class="login-button"
      loading="{{isLoading}}"
      disabled="{{isLoading}}"
      bindtap="login"
    >
      微信登录
    </button>

    <view class="profile-stats">
      <view class="profile-stat">
        <text class="stat-value">—</text>
        <text class="stat-label">收藏</text>
      </view>
      <view class="profile-stat">
        <text class="stat-value">—</text>
        <text class="stat-label">优惠券</text>
      </view>
      <view class="profile-stat">
        <text class="stat-value">—</text>
        <text class="stat-label">积分</text>
      </view>
    </view>
  </view>

  <view class="content-shell">
    <view class="me-card order-card">
      <view class="card-heading">
        <text class="card-heading-title">订单中心</text>
        <view class="card-heading-link" data-key="orders" bindtap="openFeature">
          <text>查看全部</text>
          <text class="chevron">›</text>
        </view>
      </view>

      <view class="order-grid">
        <view
          class="order-item"
          wx:for="{{orderActions}}"
          wx:key="title"
          data-key="{{item.key}}"
          bindtap="openFeature"
        >
          <view class="order-icon">{{item.icon}}</view>
          <text class="order-title">{{item.title}}</text>
        </view>
      </view>
    </view>

    <view class="me-card service-card">
      <view class="card-heading">
        <text class="card-heading-title">我的服务</text>
      </view>

      <view class="service-grid">
        <view
          class="service-item"
          wx:for="{{serviceTiles}}"
          wx:key="title"
          data-key="{{item.key}}"
          bindtap="openFeature"
        >
          <view class="service-icon tone-{{item.tone}}">{{item.icon}}</view>
          <text class="service-title">{{item.title}}</text>
        </view>
      </view>
    </view>

    <view class="experience-note">
      <view class="brand-dot pink"></view>
      <text>小海童话内容与 AI 服务使用粉蓝品牌色；胖竹全球相关能力继续使用胖竹绿。</text>
    </view>
  </view>
</view>
