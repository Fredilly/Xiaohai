<view class="me-page">
  <view class="passport-hero">
    <view class="passport-art" aria-hidden="true">
      <view class="paper-leaf leaf-one"></view>
      <view class="paper-leaf leaf-two"></view>
      <view class="paper-book"><view class="paper-page paper-left"></view><view class="paper-page paper-right"></view></view>
    </view>
    <text class="passport-kicker">XIAOHAI · READER PASSPORT</text>
    <view class="profile-row">
      <button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="chooseAvatar">
        <image wx:if="{{avatarUrl}}" class="avatar-image" src="{{avatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar-fallback"><image class="avatar-symbol" src="/assets/ui/user.svg" mode="aspectFit" /></view>
      </button>

      <view class="profile-copy">
        <text class="profile-name">{{isLoggedIn ? '小海用户' : '欢迎来到小海'}}</text>
        <text class="profile-status">{{status}}</text>
        <text wx:if="{{isLoggedIn}}" class="profile-id">ID {{consumerDisplayId}}</text>
      </view>

      <view class="profile-setting" data-key="settings" bindtap="openFeature">
        <image class="setting-symbol" src="/assets/ui/settings.svg" mode="aspectFit" />
      </view>
    </view>

    <button
      wx:if="{{!isLoggedIn}}"
      class="login-button"
      loading="{{isLoading}}"
      disabled="{{isLoading}}"
      bindtap="login"
    >微信登录</button>
    <text wx:if="{{!isLoggedIn}}" class="passport-note">登录后可查看自己的订单、作品与租借服务。</text>
    <text wx:else class="passport-note">在这里整理属于你的阅读与创作旅程。</text>
  </view>

  <view class="content-shell">
    <view class="me-card order-card">
      <view class="card-heading">
        <view class="card-heading-copy">
          <text class="section-kicker">MY ORDERS</text>
          <text class="card-heading-title">订单中心</text>
        </view>
        <view class="card-heading-link" data-key="orders" bindtap="openFeature">
          <text>查看全部</text>
          <text class="chevron">›</text>
        </view>
      </view>

      <view class="order-grid">
        <view
          class="order-item"
          wx:for="{{orderActions}}"
          wx:key="title"
          data-key="{{item.key}}"
          bindtap="openFeature"
        >
          <view class="order-icon"><image class="tile-symbol" src="/assets/ui/{{item.icon}}.svg" mode="aspectFit" /></view>
          <text class="order-title">{{item.title}}</text>
        </view>
      </view>
    </view>

    <view class="me-card service-card">
      <view class="card-heading">
        <view class="card-heading-copy">
          <text class="section-kicker">READ · CREATE · DISCOVER</text>
          <text class="card-heading-title">我的服务</text>
        </view>
      </view>
      <view class="service-grid">
        <view
          class="service-item"
          wx:for="{{serviceTiles}}"
          wx:key="title"
          data-key="{{item.key}}"
          bindtap="openFeature"
        >
          <view class="service-icon tone-{{item.tone}}"><image class="tile-symbol" src="/assets/ui/{{item.icon}}.svg" mode="aspectFit" /></view>
          <text class="service-title">{{item.title}}</text>
        </view>
      </view>
    </view>
    <text class="service-footer">订单与作品以实际账户数据为准，未开放服务以页面提示为准。</text>
  </view>
</view>
