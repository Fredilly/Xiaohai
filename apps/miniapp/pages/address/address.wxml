<view class="page"><view class="section"><button bindtap="add">新增地址</button><text>地址由当前 Consumer Session 隔离。</text></view><view wx:if="{{loading}}" class="state-card">地址加载中…</view><view wx:elif="{{error}}" class="state-card">加载失败</view><view wx:elif="{{addresses.length===0}}" class="state-card">暂无地址</view><view wx:else class="section"><view class="list-card" wx:for="{{addresses}}" wx:key="id"><text>{{item.recipientName}} {{item.phone}}</text><text>{{item.region}}{{item.city}}{{item.district}}{{item.addressLine}}</text><text wx:if="{{item.isDefault}}">默认</text></view></view></view>
