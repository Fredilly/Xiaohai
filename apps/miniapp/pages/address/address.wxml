<view class="page"><view class="section"><button bindtap="add">新增地址</button><text>地址只按当前 Consumer Session 读取和修改。</text></view><view wx:if="{{loading}}" class="state-card">地址加载中…</view><view wx:elif="{{error}}" class="state-card">加载或保存失败<button bindtap="load">重试</button></view><view wx:elif="{{addresses.length===0}}" class="state-card">暂无地址</view><view wx:else class="section"><view class="list-card" wx:for="{{addresses}}" wx:key="id"><view><text>{{item.recipientName}} {{item.phone}}</text><text>{{item.region}}{{item.city}}{{item.district}}{{item.addressLine}}</text><text wx:if="{{item.isDefault}}">默认地址</text></view><button size="mini" data-id="{{item.id}}" bindtap="edit">编辑</button><button wx:if="{{!item.isDefault}}" size="mini" data-id="{{item.id}}" bindtap="makeDefault">设为默认</button><button size="mini" data-id="{{item.id}}" bindtap="remove">删除</button></view></view></view>
