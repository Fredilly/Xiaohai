<view class="page">
  <view class="section-head"><text class="section-title">收货地址</text><button class="primary-btn address-add" bindtap="add">新增地址</button></view>
  <view wx:if="{{loading}}" class="state-card">正在加载地址…</view>
  <view wx:elif="{{error}}" class="state-card"><text class="state-title">地址加载或保存失败</text><button bindtap="load">重试</button></view>
  <view wx:elif="{{addresses.length===0}}" class="state-card"><text class="state-title">还没有收货地址</text></view>
  <view wx:else class="address-list"><view class="address-card" wx:for="{{addresses}}" wx:key="id">
    <view class="address-heading"><text class="card-title">{{item.recipientName}}　{{item.phone}}</text><text wx:if="{{item.isDefault}}" class="state-pill">默认</text></view>
    <text class="state-copy">{{item.region}}{{item.city}}{{item.district}}{{item.addressLine}}</text>
    <view class="address-actions"><button size="mini" data-id="{{item.id}}" bindtap="edit">编辑</button><button wx:if="{{!item.isDefault}}" size="mini" data-id="{{item.id}}" bindtap="makeDefault">设为默认</button><button size="mini" data-id="{{item.id}}" bindtap="remove">删除</button></view>
  </view></view>
</view>
