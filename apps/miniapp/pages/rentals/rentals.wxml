<view class="page pangzhu">
  <view class="hero hero-soft"><text class="hero-title">我的租借</text><text class="hero-subtitle">查看预约、借阅、到期与归还状态。</text></view>
  <view wx:if="{{loading}}" class="state-card">正在加载…</view>
  <view wx:elif="{{needsLogin}}" class="state-card"><text class="state-title">登录后查看租借记录</text><text class="state-copy">租借记录属于个人账户，请先微信登录。</text><button class="primary-btn" bindtap="goToLogin">去登录</button></view>
  <view wx:elif="{{error}}" class="state-card"><text class="state-title">{{error}}</text><button bindtap="load">重试</button></view>
  <view wx:elif="{{items.length === 0}}" class="state-card">暂无租借记录</view>
  <view wx:else class="section rental-list"><view wx:for="{{items}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open"><text class="section-title">{{item.storeName}}</text><text class="book-meta">{{item.rentalNumber}} · {{item.statusText}}</text><text class="book-meta">到期：{{item.dueText}}</text><text wx:if="{{item.isOverdue}}" class="demo-note">已逾期，请尽快到店归还</text></view></view>
</view>
