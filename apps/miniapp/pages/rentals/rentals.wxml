<view class="page"><view class="hero hero-soft"><text class="eyebrow">MY RENTALS</text><text class="hero-title">我的租借</text><text class="hero-subtitle">查看预约、借阅、到期与归还状态。</text></view><view wx:if="{{error}}" class="demo-note">{{error}}</view><view wx:if="{{loading}}" class="state-card">正在加载…</view><view wx:elif="{{items.length === 0 && !error}}" class="state-card">暂无租借记录</view><view class="section"><view wx:for="{{items}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open"><text class="section-title">{{item.storeName}}</text><text class="book-meta">{{item.rentalNumber}} · {{item.statusText}}</text><text class="book-meta">到期：{{item.dueText}}</text><text wx:if="{{item.isOverdue}}" class="demo-note">已逾期，请尽快到店归还（当前不计算罚金）</text></view></view></view>
