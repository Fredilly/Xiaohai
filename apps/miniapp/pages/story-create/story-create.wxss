.form-card {
  background: #fff;
  border: 1rpx solid #ebe5da;
  border-radius: 24rpx;
  padding: 26rpx;
}

.field-label {
  display: block;
  margin: 24rpx 0 10rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.field-label:first-child {
  margin-top: 0;
}

.field-input,
.field-textarea {
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid #ded8cd;
  border-radius: 16rpx;
  background: #faf8f3;
  padding: 18rpx;
  font-size: 25rpx;
}

.field-textarea {
  min-height: 220rpx;
}

.secondary-btn {
  margin-top: 20rpx;
  border: 1rpx solid #d9d2c6;
  border-radius: 18rpx;
  background: #fff;
  color: #315d45;
  font-size: 25rpx;
}

.error-note {
  margin-top: 18rpx;
  color: #9a463b;
  font-size: 23rpx;
}
.step-label {
  display: block;
  margin: 28rpx 0 12rpx;
  padding-top: 15rpx;
  border-top: 1rpx solid #e8edf1;
  color: #6b8296;
  font-size: 23rpx;
  font-weight: 700;
}
