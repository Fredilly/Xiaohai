.form-card {
  background: #fff;
  border: 1rpx solid #ebe5da;
  border-radius: 24rpx;
  padding: 26rpx;
}

.field-label {
  display: block;
  margin: 24rpx 0 10rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.field-label:first-child {
  margin-top: 0;
}

.field-input,
.field-textarea {
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid #ded8cd;
  border-radius: 16rpx;
  background: #faf8f3;
  padding: 18rpx;
  font-size: 25rpx;
}

.field-textarea {
  min-height: 220rpx;
}

.secondary-btn {
  margin-top: 20rpx;
  border: 1rpx solid #d9d2c6;
  border-radius: 18rpx;
  background: #fff;
  color: #315d45;
  font-size: 25rpx;
}

.error-note {
  margin-top: 18rpx;
  color: #9a463b;
  font-size: 23rpx;
}
.step-label {
  display: block;
  margin: 28rpx 0 12rpx;
  padding-top: 15rpx;
  border-top: 1rpx solid #e8edf1;
  color: #6b8296;
  font-size: 23rpx;
  font-weight: 700;
}

.mode-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.mode-btn {
  margin: 0;
  padding: 20rpx 16rpx;
  border: 1rpx solid #ded8cd;
  border-radius: 18rpx;
  background: #faf8f3;
  color: #525b62;
  text-align: left;
}

.mode-btn.active {
  border-color: #6b8296;
  background: #edf3f7;
  color: #314757;
}

.mode-title,
.mode-copy,
.save-note {
  display: block;
}

.mode-title {
  font-size: 24rpx;
  font-weight: 800;
}

.mode-copy {
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 1.5;
}

.save-note {
  margin-bottom: 14rpx;
  color: #6b8296;
  font-size: 21rpx;
}
