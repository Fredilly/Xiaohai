<view class="page"><view wx:if="{{loading}}" class="state-card">订单加载中…</view><view wx:elif="{{error}}" class="state-card">订单不可访问或操作失败</view><view wx:elif="{{order}}" class="section"><text class="section-title">{{order.orderNumber}}</text><text>状态 {{order.status}} · ¥{{order.totalMinor/100}}</text><view wx:for="{{order.items}}" wx:key="id"><text>{{item.productName}} · {{item.skuName}} × {{item.quantity}} · ¥{{item.lineTotalMinor/100}}</text></view><button wx:if="{{order.status==='UNPAID'}}" bindtap="pay" disabled="{{paying}}" loading="{{paying}}">微信支付</button><button wx:if="{{order.status==='UNPAID'}}" bindtap="cancel" disabled="{{paying}}">取消订单</button><button bindtap="load">刷新订单状态</button><text>{{paymentMessage}}</text><text>支付结果以服务端确认状态为准；未配置商户支付时不可付款。</text></view></view>
