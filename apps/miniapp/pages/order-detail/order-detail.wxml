<view class="page"><view wx:if="{{loading}}" class="state-card">订单加载中…</view><view wx:elif="{{error}}" class="state-card">订单不可访问或操作失败</view><view wx:elif="{{order}}" class="section"><text class="section-title">{{order.orderNumber}}</text><text>状态 {{order.status}} · ¥{{order.totalMinor/100}}</text><view wx:for="{{order.items}}" wx:key="id"><text>{{item.productName}} · {{item.skuName}} × {{item.quantity}} · ¥{{item.lineTotalMinor/100}}</text></view><button wx:if="{{order.status==='UNPAID'}}" bindtap="cancel">取消订单</button><text>支付将在 M6 开放；当前订单保持 UNPAID，绝不模拟已支付。</text></view></view>
