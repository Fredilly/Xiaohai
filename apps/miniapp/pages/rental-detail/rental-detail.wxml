<view class="page"><view wx:if="{{loading}}" class="state-card">正在加载…</view><view wx:if="{{error}}" class="demo-note">{{error}}</view><view wx:if="{{rental}}" class="card"><text class="hero-title">{{rental.statusText}}</text><text class="book-meta">{{rental.storeName}}</text><text class="book-meta">编号 {{rental.rentalNumber}}</text><text class="book-meta">到期 {{rental.dueText}}</text><view class="section"><text class="section-title">图书</text><view wx:for="{{rental.items}}" wx:key="id"><text class="book-meta">{{item.skuName}} × {{item.quantity}}</text></view></view><button wx:if="{{rental.status === 'RESERVED'}}" class="primary-btn" loading="{{busy}}" disabled="{{busy}}" bindtap="cancel">取消预约</button><view class="demo-note">借出与归还需由授权门店员工确认；当前不包含取书码、押金、租金或逾期收费。</view></view></view>
