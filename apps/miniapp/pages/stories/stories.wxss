.story-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}
.story-row {
  display: flex;
  align-items: center;
  gap: 19rpx;
  padding: 17rpx;
  border-radius: 22rpx;
  background: #fff;
}
.story-row:active {
  opacity: 0.78;
}
.story-cover {
  flex: none;
  width: 176rpx;
  height: 142rpx;
  border-radius: 15rpx;
}
.story-copy {
  flex: 1;
  min-width: 0;
}
.story-copy .list-meta {
  margin-top: 9rpx;
}
.story-description {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
