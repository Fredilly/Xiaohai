.page {
  padding: 32rpx;
}
.search {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.search input {
  flex: 1;
  background: #fff;
  padding: 20rpx;
  border-radius: 16rpx;
}
.card {
  display: flex;
  gap: 20rpx;
  background: #fff;
  padding: 20rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}
.card image {
  width: 180rpx;
  height: 120rpx;
  border-radius: 12rpx;
}
.card text {
  display: block;
  margin-bottom: 8rpx;
}
.title {
  font-weight: 700;
  font-size: 32rpx;
}
