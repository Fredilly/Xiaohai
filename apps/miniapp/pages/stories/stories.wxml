<view class="page"><view class="search"><input placeholder="搜索故事/动画" value="{{q}}" bindinput="onQuery"/><button bindtap="search">搜索</button></view><view wx:if="{{loading}}">加载中…</view><view wx:elif="{{error}}">{{error}}</view><view wx:elif="{{!series.length}}">暂无已发布内容</view><view wx:else><view class="card" wx:for="{{series}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill"/><view><text class="title">{{item.title}}</text><text>{{item.category}}</text><text>{{item.description}}</text></view></view></view></view>
