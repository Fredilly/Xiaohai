<view class="page">
  <text class="page-heading">小海童话动画</text>
  <view class="search-toolbar"><input placeholder="搜索故事或动画" value="{{q}}" bindinput="onQuery" confirm-type="search" bindconfirm="search" /><button bindtap="search">搜索</button></view>
  <view wx:if="{{loading}}" class="state-card">正在加载故事…</view>
  <view wx:elif="{{error}}" class="state-card"><text class="state-title">内容暂时无法加载</text><text class="state-copy">{{error}}</text><button bindtap="search">重试</button></view>
  <view wx:elif="{{!series.length}}" class="state-card">暂无已发布内容</view>
  <view wx:else class="story-list"><view class="story-row" wx:for="{{series}}" wx:key="id" data-id="{{item.id}}" bindtap="open">
    <image wx:if="{{item.coverUrl}}" class="story-cover" src="{{item.coverUrl}}" mode="aspectFill" /><view wx:else class="story-cover book-cover-placeholder">暂无封面</view>
    <view class="story-copy"><text class="list-title">{{item.title}}</text><text class="list-meta">{{item.category}}</text><text class="list-meta story-description">{{item.description}}</text></view><text class="arrow">›</text>
  </view></view>
</view>
