<view class="page">
  <view class="hero hero-soft"><text class="hero-title">从故事创建动画</text></view>
  <view class="card">
    <text class="step-label">01　为动画取名</text><text class="card-title">动画标题</text>
    <input value="{{title}}" maxlength="120" bindinput="inputTitle"/>
    <text class="step-label">02　开始制作</text>
    <button class="primary-btn" loading="{{submitting}}" disabled="{{submitting || creationUnknown || createdId || !workId || !versionId}}" bindtap="submit">创建动画</button>
    <text wx:if="{{error}}" class="state-copy">{{error}}</text>
    <button wx:if="{{creationUnknown}}" bindtap="viewExisting">前往我的动画检查</button>
    <button wx:if="{{createdId}}" bindtap="openCreated">查看已创建的动画</button>
  </view>
</view>
