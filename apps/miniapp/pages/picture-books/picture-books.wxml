<view class="page">
  <view class="section-head"><text class="section-title">我的绘本</text></view>
  <view wx:if="{{loading}}" class="state-card"><text>正在加载…</text></view>
  <view wx:elif="{{error}}" class="state-card"><text>{{error}}</text><button bindtap="load">重试</button></view>
  <view wx:elif="{{books.length === 0}}" class="state-card"><text>还没有绘本，请从故事正文创建。</text></view>
  <view wx:else class="book-list reader-list">
    <view wx:for="{{books}}" wx:key="id" class="list-card" data-id="{{item.id}}" bindtap="open">
      <view class="book-cover book-cover-placeholder">绘本</view><view class="list-main"><text class="list-title">{{item.title}}</text><text class="state-pill">{{item.status === 'READY' ? '已完成' : item.status === 'ILLUSTRATING' ? '插画制作中' : item.status === 'PLANNED' ? '等待插画' : '创作中'}}</text></view><text>›</text>
    </view>
  </view>
</view>
