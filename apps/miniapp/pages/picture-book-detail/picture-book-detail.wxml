<view class="page">
  <view wx:if="{{loading}}" class="state-card">正在加载绘本…</view>
  <view wx:elif="{{!detail}}" class="state-card"><text>{{error}}</text><button bindtap="load">重试</button></view>
  <block wx:else>
    <view class="hero hero-soft"><text class="hero-title">{{detail.pictureBook.title}}</text><text>{{detail.pictureBook.status === 'READY' ? '已完成' : detail.pictureBook.status === 'ILLUSTRATING' ? '插画制作中' : detail.pictureBook.status === 'PLANNED' ? '等待插画' : '创作中'}}</text></view>
    <view wx:if="{{error}}" class="error-note">{{error}}</view>
    <view class="section">
      <view class="section-head"><text class="section-title">角色设定</text><text class="section-note">{{detail.characters.length}} 个角色</text></view>
      <view wx:for="{{detail.characters}}" wx:key="characterId" class="state-card character-card"><text>角色名</text><input value="{{item.name}}" data-index="{{index}}" data-field="name" disabled="{{item.locked}}" bindinput="editCharacterField" /><text>角色描述</text><textarea value="{{item.description}}" data-index="{{index}}" data-field="description" disabled="{{item.locked}}" bindinput="editCharacterField" /><text>固定视觉描述</text><textarea value="{{item.canonicalVisualPrompt}}" data-index="{{index}}" data-field="canonicalVisualPrompt" disabled="{{item.locked}}" bindinput="editCharacterField" /><button wx:if="{{!item.locked}}" size="mini" data-character-id="{{item.characterId}}" loading="{{busy}}" disabled="{{busy}}" bindtap="reference">生成/重生成参考图</button><view wx:for="{{references[item.characterId]}}" wx:for-item="revision" wx:key="id"><image wx:if="{{revision.playbackUrl}}" class="illustration-image" src="{{revision.playbackUrl}}" mode="widthFix" /><text>{{revision.status === 'READY' ? '可用参考图' : revision.status === 'FAILED' ? '生成失败（' + (revision.errorCode || 'REFERENCE_GENERATION_FAILED') + '）' : revision.status === 'RUNNING' ? '生成中' : '排队中'}}</text><button wx:if="{{revision.status === 'READY' && !item.locked}}" size="mini" data-character-id="{{item.characterId}}" data-revision-id="{{revision.id}}" bindtap="selectReference">{{item.referenceMediaAssetId === revision.mediaAssetId ? '已选择' : '选择此图'}}</button></view><text wx:if="{{item.locked}}" class="section-note">已确认并锁定</text><button wx:if="{{!item.locked}}" size="mini" data-index="{{index}}" loading="{{busy}}" disabled="{{busy}}" bindtap="saveCharacter">保存角色设定</button></view>
      <button wx:if="{{detail.characters.length > 0 && !characterBibleConfirmed}}" class="primary-btn" loading="{{busy}}" disabled="{{busy}}" bindtap="confirmCharacters">确认角色设定</button>
      <button wx:if="{{characterBibleConfirmed}}" class="primary-btn" loading="{{busy}}" disabled="{{busy}}" bindtap="reopenCharacters">重新编辑角色设定</button>
    </view>
    <view class="section">
      <view class="section-head"><text class="section-title">分页与整书预览</text><text class="section-note">{{detail.pages.length}} 页</text></view>
      <button wx:if="{{characterBibleConfirmed && detail.pages.length === 0}}" class="primary-btn" data-operation="STORYBOARD" loading="{{busy}}" disabled="{{busy}}" bindtap="generatePlan">生成分页分镜</button>
      <view wx:if="{{detail.pages.length === 0 && detail.characters.length > 0}}" class="state-card">请先保存并确认角色设定</view>
      <view wx:for="{{detail.pages}}" wx:key="id" class="page-card">
        <text wx:if="{{item.pageKind === 'COVER'}}" class="page-heading">封面</text>
        <text wx:else class="page-heading">第 {{item.pageNumber}} 页</text>
        <text wx:if="{{item.storyText}}" class="story-copy">{{item.storyText}}</text>

        <view wx:if="{{item.illustrations.length === 0}}" class="image-placeholder">尚未生成插画</view>
        <view wx:else class="revision-list">
          <view wx:for="{{item.illustrations}}" wx:for-item="revision" wx:key="id" class="revision-card">
            <text>第 {{revision.revisionNumber}} 次插画 · {{revision.status === 'READY' ? '已完成' : revision.status === 'FAILED' ? '生成失败' : revision.status === 'RUNNING' ? '制作中' : '排队中'}}</text>

            <image wx:if="{{revision.status === 'READY' && revision.playbackUrl}}" class="illustration-image" mode="widthFix" src="{{revision.playbackUrl}}" />

            <text wx:if="{{revision.errorCode}}" class="error-note">插画生成失败，可重新尝试。</text>
          </view>
        </view>
        <button wx:if="{{item.illustrations.length === 0}}" data-page-id="{{item.id}}" data-regenerate="false" disabled="{{busy}}" bindtap="illustrate">生成本页插画</button>
        <button wx:else data-page-id="{{item.id}}" data-regenerate="true" disabled="{{busy}}" bindtap="illustrate">重新生成（保留历史）</button>
      </view>
    </view>
  </block>
</view>
