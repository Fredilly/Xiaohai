.character-card,
.page-card {
  margin-bottom: 18rpx;
}
.character-card text,
.page-card text {
  display: block;
  margin-top: 8rpx;
}
.page-card {
  background: #fff;
  border: 1rpx solid #e8edf1;
  border-radius: 24rpx;
  padding: 24rpx;
}
.page-heading {
  font-size: 30rpx;
  font-weight: 800;
}
.story-copy {
  font-size: 26rpx;
  line-height: 1.8;
}
.image-placeholder,
.revision-card {
  margin: 18rpx 0;
  padding: 22rpx;
  border-radius: 16rpx;
  background: #f7f9fa;
}
.revision-list {
  margin-top: 14rpx;
}
.page-card {
  border: 1rpx solid #e8edf1;
  border-radius: 23rpx;
  background: #fff;
  margin: 20rpx 0;
  padding: 25rpx;
}
.story-copy {
  display: block;
  line-height: 1.85;
  font-size: 27rpx;
  margin: 20rpx 0;
}
.revision-card {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 16rpx;
  background: #f7f9fa;
  border-radius: 13rpx;
}
