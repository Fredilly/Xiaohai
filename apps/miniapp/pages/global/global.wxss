/* #130 Stage 2: map-first, storybook-inspired Pangzhu Global.
 * Keep the native map, original data states, handlers and routes intact. */
.page.pangzhu-global {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 26rpx 26rpx 90rpx;
  background: #fff9ef;
  color: #263f34;
}
.pangzhu-masthead {
  position: relative;
  overflow: hidden;
  padding: 22rpx 26rpx 19rpx;
  border-radius: 30rpx;
  background: #e3f0df;
}
.pangzhu-masthead::before,
.pangzhu-masthead::after {
  position: absolute;
  right: -30rpx;
  display: block;
  width: 145rpx;
  height: 210rpx;
  border-radius: 90% 6% 90% 6%;
  background: rgba(101, 155, 100, 0.14);
  content: '';
  transform: rotate(-35deg);
}
.pangzhu-masthead::before {
  top: -80rpx;
}
.pangzhu-masthead::after {
  right: 30rpx;
  bottom: -160rpx;
  transform: rotate(28deg);
}
.masthead-kicker {
  position: relative;
  display: block;
  color: #4f8067;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.hero-title {
  position: relative;
  display: block;
  margin: 7rpx 0 5rpx;
  color: #244e3c;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.3;
}
.hero-subtitle {
  position: relative;
  display: block;
  max-width: 560rpx;
  color: #536d5c;
  font-size: 23rpx;
  line-height: 1.5;
}
.hero-links {
  position: relative;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 13rpx;
}
.hero-links text {
  padding: 12rpx 20rpx;
  border: 1rpx solid #c9ddc8;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.76);
  color: #2a674c;
  font-size: 22rpx;
  font-weight: 700;
}
.quick-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
}
.quick-action {
  box-sizing: border-box;
  display: flex;
  flex: 1;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
  min-height: 96rpx;
  padding: 11rpx 13rpx;
  border: 1rpx solid #e1e9dd;
  border-radius: 22rpx;
  background: #fff;
}
.quick-action:active,
.service-entry:active,
.store-card:active,
.franchise-card:active {
  opacity: 0.75;
}
.quick-icon,
.service-icon {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 53rpx;
  height: 53rpx;
  border-radius: 16rpx;
  background: #e9f4e8;
}
.quick-icon image,
.service-icon image {
  width: 31rpx;
  height: 31rpx;
}
.quick-text {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}
.quick-title {
  display: block;
  color: #315642;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.4;
}
.quick-subtitle {
  display: block;
  color: #728477;
  font-size: 19rpx;
  line-height: 1.35;
}
.quick-arrow {
  color: #7d9a88;
  font-size: 32rpx;
}
.card,
.section {
  box-sizing: border-box;
  padding: 23rpx;
  border: 1rpx solid #ece8dc;
  border-radius: 28rpx;
  background: #fff;
}
.store-search,
.map-section,
.store-section {
  margin-top: 16rpx;
}
.search-heading,
.service-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 17rpx;
}
.search-heading text:first-child,
.service-heading text:first-child {
  color: #315542;
  font-size: 27rpx;
  font-weight: 800;
}
.search-heading text:last-child,
.service-heading text:last-child {
  color: #7c8c7e;
  font-size: 19rpx;
}
.search-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.search-input {
  box-sizing: border-box;
  flex: 1;
  min-width: 0;
  min-height: 76rpx;
  padding: 0 18rpx;
  border: 1rpx solid #e2e9e0;
  border-radius: 16rpx;
  background: #f6faf5;
  color: #324c3c;
  font-size: 24rpx;
}
.search-btn {
  flex: none;
  height: 76rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 0;
  border-radius: 16rpx;
  background: #2d7654;
  color: #fff;
  font-size: 23rpx;
  line-height: 76rpx;
}
.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.filter-pill {
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  min-height: 65rpx;
  padding: 10rpx 17rpx;
  border: 1rpx solid #dce8d9;
  border-radius: 999rpx;
  background: #f6faf5;
  color: #416650;
  font-size: 21rpx;
}
.button-pill {
  margin: 0;
  line-height: 1.5;
}
.button-pill.active {
  background: #dcebdc;
  color: #2b654a;
}
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.section-heading {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.section-kicker {
  color: #7b9a80;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 1.5rpx;
}
.section-title {
  color: #294a38;
  font-size: 31rpx;
  font-weight: 800;
}
.section-note {
  flex: none;
  color: #63816a;
  font-size: 21rpx;
}
.store-map {
  display: block;
  width: 100%;
  height: 460rpx;
  border-radius: 18rpx;
  background: #edf3e9;
}
.map-caption {
  display: block;
  margin-top: 13rpx;
  color: #738677;
  font-size: 20rpx;
  line-height: 1.5;
}
.store-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.store-card {
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  min-width: 0;
  padding: 20rpx;
  border: 1rpx solid #e3eade;
  border-radius: 22rpx;
  background: #f8fbf6;
}
.store-mark {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  background: #e7f2e6;
}
.store-mark image {
  width: 27rpx;
  height: 27rpx;
}
.list-main {
  flex: 1;
  min-width: 0;
}
.store-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10rpx;
}
.list-title {
  display: block;
  min-width: 0;
  color: #294c39;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.5;
  overflow-wrap: break-word;
  white-space: normal;
}
.list-meta {
  display: block;
  margin-top: 8rpx;
  color: #687c6e;
  font-size: 21rpx;
  line-height: 1.5;
  overflow-wrap: break-word;
}
.distance,
.chip {
  flex: none;
  padding: 6rpx 11rpx;
  border-radius: 999rpx;
  background: #e5f0e2;
  color: #41664e;
  font-size: 19rpx;
}
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}
.arrow {
  align-self: center;
  color: #789783;
  font-size: 34rpx;
}
.state-card {
  box-sizing: border-box;
  padding: 42rpx 20rpx;
  border-radius: 20rpx;
  background: #f5f9f2;
  text-align: center;
}
.state-title {
  display: block;
  color: #375c43;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.5;
}
.state-copy {
  display: block;
  margin-top: 10rpx;
  color: #6a8072;
  font-size: 22rpx;
  line-height: 1.6;
}
.state-card button {
  margin: 20rpx auto 0;
  border-radius: 14rpx;
  background: #e0ece0;
  color: #28543f;
}
.demo-note {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #fff1e5;
  color: #98643f;
  font-size: 21rpx;
  line-height: 1.5;
}
.demo-note button {
  flex: none;
  margin: 0;
  border-radius: 10rpx;
}
.more-services {
  margin-top: 30rpx;
}
.service-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.service-entry {
  box-sizing: border-box;
  display: flex;
  flex: 1 1 22%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-width: 0;
  min-height: 122rpx;
  padding: 15rpx 4rpx;
  border: 1rpx solid #e4eade;
  border-radius: 18rpx;
  background: #fff;
  color: #42614b;
  font-size: 20rpx;
  text-align: center;
}
.service-icon {
  width: 44rpx;
  height: 44rpx;
}
.service-icon image {
  width: 28rpx;
  height: 28rpx;
}
.service-hint {
  margin: 13rpx 2rpx 0;
  color: #7e8b7f;
  font-size: 20rpx;
  line-height: 1.5;
}
.franchise-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 28rpx;
  background: #e8f2e4;
}
.franchise-copy {
  flex: 1;
  min-width: 0;
}
.card-title {
  display: block;
  color: #315b43;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.4;
}
.card-subtitle {
  display: block;
  margin-top: 7rpx;
  color: #697e6c;
  font-size: 21rpx;
  line-height: 1.5;
}
.franchise-link {
  flex: none;
  color: #2e7654;
  font-size: 22rpx;
  font-weight: 700;
}
