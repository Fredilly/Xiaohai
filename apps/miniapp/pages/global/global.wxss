.page {
  min-height: 100vh;
  padding: 24rpx 26rpx 76rpx;
  box-sizing: border-box;
  background: #f7f8fa;
  color: #354640;
}
.hero-soft {
  position: relative;
  padding: 36rpx;
  border-radius: 28rpx;
  background: linear-gradient(125deg, #dcebdc, #e8f2e8 58%, #e6f2ed);
  margin-bottom: 30rpx;
}
.eyebrow {
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: #688573;
}
.hero-title {
  display: block;
  margin: 12rpx 0;
  font-size: 43rpx;
  font-weight: 800;
}
.hero-subtitle {
  display: block;
  max-width: 550rpx;
  color: #60766a;
  font-size: 24rpx;
  line-height: 1.6;
}
.hero-links {
  display: flex;
  gap: 14rpx;
  margin-top: 30rpx;
  font-size: 23rpx;
  color: #456b56;
}
.hero-links text {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.7);
}
.service-heading,
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 16rpx;
  margin: 24rpx 4rpx 18rpx;
}
.service-heading text:first-child,
.section-title {
  font-size: 31rpx;
  font-weight: 800;
}
.service-heading text:last-child,
.section-note {
  font-size: 22rpx;
  color: #8a9a90;
}
.service-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}
.service-entry {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-height: 142rpx;
  background: #fff;
  border: 1rpx solid #edf1ee;
  border-radius: 22rpx;
  color: #52665a;
  font-size: 22rpx;
}
.service-entry:active,
.franchise-card:active,
.store-card:active {
  opacity: 0.76;
}
.service-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 17rpx;
  background: #eef5ee;
}
.service-icon image {
  width: 33rpx;
  height: 33rpx;
}
.service-hint {
  margin: 14rpx 6rpx 22rpx;
  color: #8a9a90;
  font-size: 20rpx;
}
.card,
.section {
  padding: 26rpx;
  margin-top: 22rpx;
  border: 1rpx solid #edf1ee;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(48, 73, 58, 0.04);
}
.franchise-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
  background: #f0f5f0;
}
.card-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
}
.card-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #73877a;
}
.franchise-link {
  flex-shrink: 0;
  color: #52755e;
  font-size: 22rpx;
}
.search-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.search-input {
  flex: 1;
  min-width: 0;
  height: 74rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  background: #f5f8f5;
  font-size: 24rpx;
}
.search-btn {
  margin: 0;
  padding: 0 24rpx;
  height: 74rpx;
  line-height: 74rpx;
  border-radius: 18rpx;
  background: #719881;
  color: #fff;
  font-size: 23rpx;
}
.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}
.filter-pill {
  display: inline-flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 54rpx;
  padding: 10rpx 16rpx;
  border: 1rpx solid #dfeae1;
  border-radius: 999rpx;
  background: #f7faf7;
  color: #5b7162;
  font-size: 21rpx;
}
.button-pill {
  margin: 0;
  line-height: 1.4;
}
.button-pill.active {
  background: #dcebdc;
}
.store-map {
  width: 100%;
  height: 420rpx;
  border-radius: 22rpx;
  overflow: hidden;
}
.store-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.list-card {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #f8faf8;
}
.list-main {
  flex: 1;
  min-width: 0;
}
.store-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}
.list-title {
  font-size: 27rpx;
  font-weight: 700;
}
.list-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #7b8c80;
}
.distance,
.chip {
  flex-shrink: 0;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: #eaf3eb;
  color: #52755e;
  font-size: 19rpx;
}
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}
.arrow {
  color: #91a797;
}
.state-card {
  padding: 36rpx 12rpx;
  text-align: center;
}
.state-title {
  display: block;
  font-size: 27rpx;
  font-weight: 700;
}
.state-copy {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8a9a90;
}
.demo-note {
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #fff4e5;
  color: #8d6b4d;
  font-size: 22rpx;
}
.retry-link {
  margin-left: 18rpx;
  text-decoration: underline;
}
/* Let real map and store data lead; keep secondary services compact. */
.hero-soft {
  padding: 28rpx 30rpx;
  margin-bottom: 14rpx;
  background: #e6f0e7;
}
.hero-title {
  margin: 0 0 8rpx;
}
.hero-links {
  margin-top: 16rpx;
}
.service-heading {
  margin: 18rpx 4rpx 12rpx;
}
.service-grid {
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
}
.service-entry {
  min-height: 98rpx;
  gap: 8rpx;
  font-size: 19rpx;
  border: 0;
  background: #f1f6f1;
}
.service-entry-primary {
  grid-column: span 2;
  flex-direction: row;
  min-height: 104rpx;
  gap: 14rpx;
  justify-content: flex-start;
  padding-left: 22rpx;
  font-size: 25rpx;
  font-weight: 700;
  background: #e7f1e8;
}
.service-icon {
  width: 40rpx;
  height: 40rpx;
  background: transparent;
}
.service-icon image {
  width: 30rpx;
  height: 30rpx;
}
.service-entry-primary .service-icon {
  width: 48rpx;
  height: 48rpx;
}
.service-entry-primary .service-icon image {
  width: 38rpx;
  height: 38rpx;
}
.service-hint {
  margin-bottom: 10rpx;
}
.franchise-card {
  margin-top: 28rpx;
}
