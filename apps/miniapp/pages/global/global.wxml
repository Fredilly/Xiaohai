<view class="page">
  <view class="hero hero-soft">
    <text class="eyebrow">PANGZHU GLOBAL</text>
    <text class="hero-title">胖竹全球</text>
    <text class="hero-subtitle">查找真实营业门店，按区域筛选或查看附近门店，并进入门店详情与导航。</text>
  </view>

  <view class="card find-book-card">
    <text class="card-title">找书</text>
    <text class="card-subtitle">按书名、作者、ISBN 或图书编码查看哪些门店当前有货。</text>
    <button class="primary-btn" bindtap="openBookSearch">开始找书</button>
  </view>

  <view class="store-search card">
    <view class="search-row">
      <input class="search-input" value="{{query}}" placeholder="搜索门店名称" bindinput="onQueryInput" confirm-type="search" bindconfirm="submitSearch" />
      <button class="search-btn" size="mini" bindtap="submitSearch" loading="{{loading}}">搜索</button>
    </view>
    <view class="filter-row">
      <picker mode="selector" range="{{regionNames}}" value="{{selectedRegionIndex}}" bindchange="onRegionChange">
        <view class="filter-pill">区域：{{regionNames[selectedRegionIndex]}}</view>
      </picker>
      <button wx:if="{{!nearbyMode}}" class="filter-pill button-pill" size="mini" bindtap="useNearby">附近门店</button>
      <button wx:else class="filter-pill button-pill active" size="mini" bindtap="disableNearby">退出附近</button>
      <button wx:if="{{query}}" class="filter-pill button-pill" size="mini" bindtap="clearSearch">清空</button>
    </view>
  </view>

  <view wx:if="{{errorMessage}}" class="demo-note">{{errorMessage}}</view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">门店地图</text>
      <text class="section-note">{{stores.length}} 家门店</text>
    </view>
    <map
      class="store-map"
      latitude="{{mapLatitude}}"
      longitude="{{mapLongitude}}"
      scale="11"
      markers="{{markers}}"
      show-location="{{nearbyMode}}"
    />
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">门店列表</text>
      <text class="section-note">营业门店</text>
    </view>

    <view wx:if="{{loading && stores.length === 0}}" class="state-card">
      <text class="state-title">正在加载门店</text>
      <text class="state-copy">请稍候。</text>
    </view>

    <view wx:elif="{{!loading && stores.length === 0}}" class="state-card">
      <text class="state-title">没有找到门店</text>
      <text class="state-copy">可以更换搜索词、区域，或关闭附近门店筛选后再试。</text>
    </view>

    <view wx:else class="store-list">
      <view class="list-card store-card" wx:for="{{stores}}" wx:key="id" data-id="{{item.id}}" bindtap="openStore">
        <view class="list-main">
          <view class="store-title-row">
            <text class="list-title">{{item.name}}</text>
            <text wx:if="{{item.distanceKm != null}}" class="distance">{{item.distanceKm}} km</text>
          </view>
          <text class="list-meta">{{item.city}} · {{item.region.name}}</text>
          <text class="list-meta">{{item.addressLine}}</text>
          <text wx:if="{{item.openingHoursText}}" class="list-meta">营业：{{item.openingHoursText}}</text>
          <view class="chips service-chips">
            <text class="chip" wx:for="{{item.services}}" wx:key="*this">{{item}}</text>
          </view>
        </view>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>
</view>
