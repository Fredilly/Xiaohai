<view class="page">
  <view class="hero hero-soft"><text class="hero-title">创建绘本</text><text>将已保存的故事正文转换为角色与分镜计划。</text></view>
  <view class="state-card creation-form">
    <text class="step-label">01　为绘本取名</text><text class="card-title">绘本标题</text>
    <input value="{{title}}" maxlength="120" bindinput="inputTitle" />
    <text class="step-label">02　开始制作</text><button class="primary-btn" loading="{{submitting}}" disabled="{{submitting || !workId || !versionId}}" bindtap="submit">创建</button>
    <text wx:if="{{error}}" class="error-note">{{error}}</text>
  </view>
</view>
