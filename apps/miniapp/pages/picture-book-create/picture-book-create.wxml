<view class="page">
  <view class="hero hero-soft"><text class="hero-title">创建绘本</text><text>将已保存的故事正文转换为角色与分镜计划。</text></view>
  <view class="state-card">
    <text class="card-title">绘本标题</text>
    <input value="{{title}}" maxlength="120" bindinput="inputTitle" />
    <button class="primary-btn" loading="{{submitting}}" disabled="{{submitting || !workId || !versionId}}" bindtap="submit">创建</button>
    <text wx:if="{{error}}" class="error-note">{{error}}</text>
  </view>
</view>
