<view class="page"><view wx:if="{{loading}}" class="state-card">购物车加载中…</view><view wx:elif="{{error}}" class="state-card">请先登录或稍后重试<button bindtap="load">重试</button></view><view wx:elif="{{!cart || cart.items.length===0}}" class="state-card">购物车为空</view><view wx:else class="section"><view class="list-card" wx:for="{{cart.items}}" wx:key="id"><view class="list-main"><text class="list-title">{{item.productName}} · {{item.skuName}}</text><text>¥{{item.lineTotalMinor/100}} · {{item.availableForSale?'可售':'不可售'}}</text><button size="mini" data-id="{{item.id}}" bindtap="minus">-</button><text>{{item.quantity}}</text><button size="mini" data-id="{{item.id}}" bindtap="plus">+</button><button size="mini" data-id="{{item.id}}" bindtap="remove">删除</button></view></view><text>小计 ¥{{cart.subtotalMinor/100}}</text><button bindtap="checkout">确认订单</button></view></view>
