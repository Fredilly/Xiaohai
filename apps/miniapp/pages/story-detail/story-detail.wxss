.story-hero-cover {
  width: 100%;
  height: 365rpx;
  border-radius: 25rpx;
  margin-bottom: 28rpx;
  background: #e9eff5;
}
.story-intro {
  display: block;
  margin: -4rpx 0 34rpx;
  line-height: 1.7;
}
.episode {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 23rpx 6rpx;
  border-bottom: 1rpx solid #e9edf1;
  font-size: 25rpx;
}
.episode:active {
  opacity: 0.78;
}
.episode .state-pill {
  flex: none;
}
