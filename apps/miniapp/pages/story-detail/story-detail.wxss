.page {
  padding: 32rpx;
}
.page > image {
  width: 100%;
  height: 360rpx;
  border-radius: 20rpx;
}
.title {
  font-size: 40rpx;
  font-weight: 700;
  margin: 24rpx 0;
}
.episode {
  display: flex;
  justify-content: space-between;
  background: #fff;
  padding: 24rpx;
  margin-top: 16rpx;
  border-radius: 16rpx;
}
