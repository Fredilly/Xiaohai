<view class="page" wx:if="{{detail}}"><image wx:if="{{detail.coverUrl}}" src="{{detail.coverUrl}}" mode="aspectFill"/><view class="title">{{detail.title}}</view><view>{{detail.description}}</view><view class="episode" wx:for="{{detail.episodes}}" wx:key="id" data-id="{{item.id}}" bindtap="play"><text>第{{item.episodeNumber}}集 · {{item.title}}</text><text wx:if="{{item.accessMode === 'FREE'}}">免费</text><text wx:elif="{{item.accessMode === 'PREVIEW'}}">试看</text><text wx:else>需权益</text></view></view><view wx:else>{{error || '加载中…'}}</view>
