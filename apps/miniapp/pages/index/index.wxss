.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 600;
}

.subtitle {
  font-size: 28rpx;
  color: #666666;
}

.status {
  max-width: 640rpx;
  font-size: 24rpx;
  color: #444444;
  overflow-wrap: anywhere;
}
