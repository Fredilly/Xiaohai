.page {
  min-height: 100vh;
  padding: 24rpx 26rpx 80rpx;
  box-sizing: border-box;
  background: #f7f8fa;
  color: #35404b;
}
.brand-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.brand-logo {
  width: 80rpx;
  height: 80rpx;
  flex: none;
}
.brand-copy {
  display: flex;
  flex-direction: column;
  gap: 3rpx;
}
.brand-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #285575;
}
.brand-note {
  font-size: 20rpx;
  color: #87909b;
}
.home-search {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 76rpx;
  padding: 0 22rpx;
  margin-bottom: 22rpx;
  border-radius: 24rpx;
  background: #fff;
  color: #858d97;
  font-size: 24rpx;
  box-shadow: 0 8rpx 22rpx rgba(74, 80, 96, 0.04);
}
.home-search:active,
.card:active,
.hero-actionable:active,
.banner:active {
  opacity: 0.8;
}
.search-icon {
  width: 32rpx;
  height: 32rpx;
}
.search-action {
  margin-left: auto;
  color: #8c7ea2;
  font-size: 22rpx;
}
.hero,
.section,
.state-card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #f0eff2;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 8rpx 26rpx rgba(74, 80, 96, 0.045);
}
.hero,
.state-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.hero {
  overflow: hidden;
  min-height: 268rpx;
  position: relative;
  background: #e9f0f5;
  border-color: #e8edf2;
}
.hero-without-media {
  padding-right: 195rpx;
}
.hero-with-media {
  background: #fff;
}
.hero-illustration {
  position: absolute;
  right: 18rpx;
  bottom: 22rpx;
  width: 162rpx;
  height: 166rpx;
}
.illustration-book {
  position: absolute;
  bottom: 10rpx;
  display: flex;
  width: 150rpx;
  height: 95rpx;
  transform: rotate(-9deg);
  filter: drop-shadow(0 9rpx 6rpx rgba(76, 91, 115, 0.16));
}
.book-left,
.book-right {
  flex: 1;
  border: 3rpx solid #91a8bd;
  background: #fffefa;
}
.book-left {
  border-radius: 9rpx 2rpx 8rpx 5rpx;
  transform: skewY(9deg);
}
.book-right {
  border-radius: 2rpx 9rpx 5rpx 8rpx;
  transform: skewY(-9deg);
}
.illustration-spark {
  position: absolute;
  top: 2rpx;
  right: 12rpx;
  color: #bfa7c9;
  font-size: 65rpx;
}
.hero-actionable {
  border-color: #e9e2ef;
}
.hero-media {
  width: 100%;
  height: 260rpx;
  margin-bottom: 8rpx;
  border-radius: 20rpx;
  background: #e8edf3;
}
.hero-cta {
  align-self: flex-start;
  margin-top: 12rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #806d93;
  font-size: 24rpx;
  font-weight: 700;
}
.eyebrow {
  font-size: 21rpx;
  letter-spacing: 2rpx;
  color: #867a96;
}
.hero-title,
.state-title {
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.35;
}
.hero-subtitle,
.state-copy,
.card-subtitle,
.list-meta {
  font-size: 24rpx;
  color: #697581;
  line-height: 1.55;
}
.section-head {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
  margin-bottom: 20rpx;
}
.section-title {
  font-size: 31rpx;
  font-weight: 800;
  color: #35404b;
}
.section-note {
  font-size: 22rpx;
  color: #9099a3;
}
.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}
.feature-section {
  border: 0;
  box-shadow: none;
  background: transparent;
  padding: 8rpx 0;
}
.card,
.list-card {
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f7f8fb;
}
.card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-height: 176rpx;
}
.card {
  background: #fff;
  border: 1rpx solid #f0eff2;
}
.card-featured {
  grid-column: span 2;
  min-height: 94rpx;
  display: grid;
  grid-template-columns: 68rpx 1fr;
  align-content: center;
  column-gap: 18rpx;
  background: #e7f0ed;
  border: 0;
}
.card-featured .feature-icon {
  grid-row: span 3;
  background: #fff;
}
.card-featured .card-subtitle {
  margin-top: 0;
}
.feature-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: #f2f0f5;
}
.feature-icon image {
  width: 36rpx;
  height: 36rpx;
}
.card-title,
.list-title {
  font-size: 27rpx;
  font-weight: 700;
}
.badge {
  align-self: flex-start;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.8);
  color: #76818b;
  font-size: 19rpx;
}
.book-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.list-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.banner {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  background: #edf5f2;
}
.state-card button {
  align-self: flex-start;
  margin: 10rpx 0 0;
  border-radius: 999rpx;
  background: #e8e6f4;
  color: #536277;
}

/* Keep the CMS Hero slot stable during loading without flashing the fallback fox. */
.home-hero-loading {
  min-height: 400rpx;
  justify-content: center;
  background: #f7f9f2;
}

/* #130 illustrated visual layer. Keep all data and navigation bindings unchanged. */
.page {
  background: #fff9ef;
  color: #24384b;
}
.brand-name {
  color: #276f57;
}
.brand-note {
  color: #697a75;
}
.storybook-intro {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  min-height: 320rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 22rpx;
  overflow: hidden;
  border-radius: 36rpx;
  background: #dff1ed;
}
.storybook-intro-copy {
  position: relative;
  z-index: 1;
  width: 58%;
  display: flex;
  flex-direction: column;
  gap: 13rpx;
}
.storybook-kicker {
  color: #28795c;
  font-size: 21rpx;
  font-weight: 700;
}
.storybook-heading {
  color: #253f48;
  font-size: 37rpx;
  line-height: 1.38;
  font-weight: 800;
  white-space: pre-line;
}
.storybook-blurb {
  color: #42635c;
  font-size: 22rpx;
  line-height: 1.5;
}
.storybook-scene {
  position: absolute;
  right: -56rpx;
  bottom: -12rpx;
  width: 385rpx;
  height: 295rpx;
}
.home-search {
  border: 2rpx solid #e5ebe3;
  background: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(37, 90, 71, 0.06);
}
.search-action {
  color: #28795c;
  font-weight: 700;
}
.hero,
.section,
.state-card {
  border-color: #eee8dc;
  border-radius: 30rpx;
  box-shadow: 0 8rpx 20rpx rgba(57, 75, 62, 0.04);
}
.hero {
  background: #fce9c9;
  border-color: #f3e0b8;
}
.hero-with-media {
  background: #fff;
}
.storybook-hero-art {
  width: 190rpx;
  height: 185rpx;
  right: 5rpx;
  bottom: 10rpx;
}
.hero-without-media {
  padding-right: 205rpx;
}
.hero-title,
.state-title {
  color: #253f48;
}
.hero-cta {
  background: #28795c;
  color: #fff;
}
.eyebrow {
  color: #28795c;
}
.section-title {
  color: #253f48;
}
.card {
  border-color: #f1e7d9;
  background: #fff;
}
.card-featured {
  background: #e1f2e5;
}
.feature-icon {
  background: #fff1d8;
}
.card-title,
.list-title {
  color: #253f48;
}
.banner {
  background: #e3f1ed;
}
.state-card button {
  background: #28795c;
  color: #fff;
}
