.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 80rpx;
  box-sizing: border-box;
  background: #f6f7f8;
}

.hero,
.section,
.state-card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.hero,
.state-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.hero {
  overflow: hidden;
}

.hero-actionable {
  border: 2rpx solid #e8dec8;
}

.hero-media {
  width: 100%;
  height: 260rpx;
  margin-bottom: 8rpx;
  border-radius: 18rpx;
  background: #f4f5f6;
}

.hero-cta {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #315d45;
}

.eyebrow,
.section-note {
  font-size: 22rpx;
  color: #7a7f87;
}

.hero-title,
.state-title {
  font-size: 44rpx;
  font-weight: 700;
}

.hero-subtitle,
.state-copy,
.card-subtitle,
.list-meta {
  font-size: 26rpx;
  color: #626871;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.section-title,
.card-title,
.list-title {
  font-size: 30rpx;
  font-weight: 600;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.card,
.list-card {
  padding: 24rpx;
  border-radius: 18rpx;
  background: #f4f5f6;
}

.card {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.badge {
  align-self: flex-start;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #eceff2;
  font-size: 20rpx;
}

.book-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.list-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.banner {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
