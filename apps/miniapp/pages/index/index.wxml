<view class="page">
  <view class="home-search" bindtap="openShop">
    <image class="search-icon" src="/assets/ui/search.svg" />
    <text>搜索童书与好故事</text>
    <text class="search-action">去商城 ›</text>
  </view>
  <view wx:if="{{loading}}" class="state-card">首页加载中…</view>
  <view wx:elif="{{error}}" class="state-card">
    <text class="state-title">首页暂时无法加载</text>
    <text class="state-copy">你仍可以使用底部导航；稍后重试不会影响登录状态。</text>
    <button size="mini" bindtap="retry">重新加载</button>
  </view>
  <view wx:elif="{{sections.length === 0}}" class="state-card">
    <text class="state-title">{{pageTitle}}</text>
    <text class="state-copy">首页内容正在准备中。</text>
  </view>
  <block wx:else>
    <block wx:for="{{sections}}" wx:key="id">
      <view
        wx:if="{{item.sectionType === 'HERO'}}"
        class="hero {{item.action ? 'hero-actionable' : ''}}"
        data-target="{{item.action.target}}"
        bindtap="openAction"
      >
        <image wx:if="{{item.mediaUrl}}" class="hero-media" src="{{item.mediaUrl}}" mode="aspectFill" />
        <text wx:if="{{item.config.eyebrow}}" class="eyebrow">{{item.config.eyebrow}}</text>
        <text class="hero-title">{{item.title}}</text>
        <text wx:if="{{item.subtitle}}" class="hero-subtitle">{{item.subtitle}}</text>
        <text wx:if="{{item.action}}" class="hero-cta">立即探索 →</text>
      </view>
      <view wx:elif="{{item.sectionType === 'FEATURE_GRID'}}" class="section">
        <view class="section-head"><text class="section-title">{{item.title}}</text><text class="section-note">{{item.subtitle}}</text></view>
        <view class="grid">
          <view class="card" wx:for="{{item.config.items}}" wx:for-item="entry" wx:key="key" data-target="{{entry.key}}" bindtap="openAction">
            <view class="feature-icon"><image src="/assets/ui/{{entry.key === 'shop' ? 'shop' : entry.key === 'story-create' || entry.key === 'ai' ? 'magic' : entry.key === 'picture-books' ? 'book' : entry.key === 'animations' ? 'play' : 'star'}}.svg" /></view>
            <text class="card-title">{{entry.title}}</text>
            <text wx:if="{{entry.subtitle}}" class="card-subtitle">{{entry.subtitle}}</text>
            <text wx:if="{{entry.badge}}" class="badge">{{entry.badge}}</text>
          </view>
        </view>
      </view>
      <view wx:elif="{{item.sectionType === 'CONTENT_LIST'}}" class="section">
        <view class="section-head"><text class="section-title">{{item.title}}</text><text class="section-note">{{item.subtitle}}</text></view>
        <view class="book-list">
          <view class="list-card" wx:for="{{item.config.items}}" wx:for-item="entry" wx:key="title">
            <view class="list-main"><text class="list-title">{{entry.title}}</text><text wx:if="{{entry.subtitle}}" class="list-meta">{{entry.subtitle}}</text></view>
          </view>
        </view>
      </view>
      <view wx:elif="{{item.sectionType === 'BANNER'}}" class="section banner" data-target="{{item.action.target}}" bindtap="openAction">
        <text class="section-title">{{item.title}}</text>
        <text class="card-subtitle">{{item.config.body}}</text>
      </view>
    </block>
  </block>
</view>
