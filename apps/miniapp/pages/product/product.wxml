<view class="page">
  <view wx:if="{{loading}}" class="state-card">正在加载商品…</view>
  <view wx:elif="{{error}}" class="state-card">
    <text class="state-title">{{accessMessage || '商品暂时不可用'}}</text>
    <button wx:if="{{id && !accessMessage}}" class="primary-btn" bindtap="retry">重新加载</button>
  </view>
  <block wx:elif="{{product}}">
    <view class="product-cover-wrap">
      <image wx:if="{{product.displayCoverUrl}}" class="product-cover" src="{{product.displayCoverUrl}}" mode="aspectFit" binderror="coverError" data-index="0" bindtap="previewGallery" />
      <view wx:else class="product-cover-empty">暂无封面</view>
    </view>
    <scroll-view wx:if="{{product.galleryUrls.length > 1}}" scroll-x="true" class="product-gallery-strip">
      <view class="product-gallery-list">
        <image wx:for="{{product.galleryUrls}}" wx:key="*this" class="product-gallery-thumb" src="{{item}}" mode="aspectFill" data-index="{{index}}" data-src="{{item}}" bindtap="previewGallery" binderror="galleryError" />
      </view>
    </scroll-view>
    <text class="page-heading">{{product.title || product.name}}</text>
    <text wx:if="{{product.author}}" class="product-meta">{{product.author}}</text>
    <text wx:if="{{product.isBook && product.isbn}}" class="product-meta">ISBN {{product.isbn}}</text>
    <text wx:if="{{product.isBook && product.publisher}}" class="product-meta">出版社：{{product.publisher}}</text>
    <view class="product-description"><text class="section-title">商品介绍</text><text class="state-copy">{{product.description || '暂无简介'}}</text></view>
    <view class="sku-list"><view wx:for="{{product.skus}}" wx:key="id" class="sku-row"><view><text class="card-title">{{item.name}}</text><text class="price">¥{{item.priceMinor / 100}}</text></view><button class="primary-btn" data-sku="{{item.id}}" disabled="{{!item.availableForSale}}" bindtap="add">{{item.availableForSale ? '加入购物车' : '暂不可购买'}}</button></view></view>
    <text wx:if="{{message}}" class="state-copy">{{message}}</text>
    <button class="cart-link" bindtap="openCart">查看购物车 ›</button>
  </block>
</view>
