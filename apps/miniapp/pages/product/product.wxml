<view class="page"><view wx:if="{{loading}}" class="state-card">商品加载中…</view><view wx:elif="{{error}}" class="state-card">商品不可用</view><view wx:elif="{{product}}" class="section"><image wx:if="{{product.coverUrl}}" src="{{product.coverUrl}}" mode="aspectFit"/><text class="section-title">{{product.title || product.name}}</text><text>{{product.author}}</text><text>ISBN {{product.isbn || '—'}} · {{product.publisher || '—'}}</text><text>{{product.description || '暂无简介'}}</text><view wx:for="{{product.skus}}" wx:key="id"><text>{{item.name}} · ¥{{item.priceMinor / 100}}</text><button data-sku="{{item.id}}" disabled="{{!item.availableForSale}}" bindtap="add">{{item.availableForSale ? '加入购物车' : '暂不可购买'}}</button></view><text>{{message}}</text><text>库存数量与门店履约将在后续库存/门店里程碑接入；M5 仅展示 SKU 可售状态。</text></view></view>
