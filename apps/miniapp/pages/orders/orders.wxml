<view class="page"><view wx:if="{{loading}}" class="state-card">订单加载中…</view><view wx:elif="{{error}}" class="state-card">请先登录或重试</view><view wx:elif="{{orders.length===0}}" class="state-card">暂无订单</view><view wx:else class="section"><view class="list-card" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><text>{{item.orderNumber}}</text><text>{{item.status}} · ¥{{item.totalMinor/100}}</text></view></view></view>
