<view class="page">
  <view class="hero"><text class="eyebrow">ANIMATION AI</text><text class="hero-title">我的 AI 动画</text><text class="hero-subtitle">从故事正文制作脚本、分镜、场景视频与预览。</text></view>
  <view wx:if="{{loading}}" class="state-card">加载中…</view>
  <view wx:elif="{{error}}" class="state-card"><text class="state-copy">{{error}}</text><button bindtap="load">重试</button></view>
  <view wx:elif="{{animations.length === 0}}" class="state-card"><text class="state-title">还没有动画</text><text class="state-copy">请从故事正文页面创建。</text></view>
  <view wx:else class="book-list"><view wx:for="{{animations}}" wx:key="id" class="list-card" data-id="{{item.id}}" bindtap="open"><view class="list-main"><text class="list-title">{{item.title}}</text><text class="list-meta">{{item.status}}</text></view><text class="arrow">›</text></view></view>
</view>
