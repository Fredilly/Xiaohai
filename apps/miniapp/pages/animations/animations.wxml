<view class="page">
  <view class="hero"><text class="hero-title">我的 AI 动画</text><text class="hero-subtitle">从故事正文制作脚本、分镜、场景视频与预览。</text></view>
  <view wx:if="{{loading}}" class="state-card">加载中…</view>
  <view wx:elif="{{error}}" class="state-card"><text class="state-copy">{{error}}</text><button bindtap="load">重试</button></view>
  <view wx:elif="{{animations.length === 0}}" class="state-card"><text class="state-title">还没有动画</text><text class="state-copy">请从故事正文页面创建。</text></view>
  <view wx:else class="book-list reader-list"><view wx:for="{{animations}}" wx:key="id" class="list-card" data-id="{{item.id}}" bindtap="open"><view class="animation-cover"><image src="/assets/ui/play.svg" /></view><view class="list-main"><text class="list-title">{{item.title}}</text><text class="state-pill {{item.status === 'FAILED' ? 'failed' : item.status === 'GENERATING' || item.status === 'COMPOSING' ? 'pending' : ''}}">{{item.status === 'READY' ? '可预览' : item.status === 'FAILED' ? '制作失败' : item.status === 'GENERATING' || item.status === 'COMPOSING' ? '制作中' : item.status === 'CANCELLED' ? '已取消' : '创作中'}}</text></view><text class="arrow">›</text></view></view>
</view>
