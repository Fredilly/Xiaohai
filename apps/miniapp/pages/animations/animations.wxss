.reader-list .list-card {
  display: flex;
  gap: 18rpx;
  margin: 14rpx 0;
}
.animation-cover {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 135rpx;
  height: 102rpx;
  border-radius: 16rpx;
  background: #e8eefa;
}
.animation-cover image {
  width: 42rpx;
  height: 42rpx;
}
.reader-list .state-pill {
  display: inline-block;
  margin-top: 12rpx;
}
