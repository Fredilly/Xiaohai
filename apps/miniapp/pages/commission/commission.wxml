<view class="page">
  <view wx:if="{{loading}}" class="state-card">正在加载佣金记录…</view>
  <block wx:else>
  <view class="commission-overview"><text class="page-heading">分享与佣金</text><view class="balance-row"><view><text class="balance-label">待结算</text><text class="balance-value">¥{{frozenMinor / 100}}</text></view><view><text class="balance-label">可提现</text><text class="balance-value">¥{{availableMinor / 100}}</text></view></view></view>
  <view wx:if="{{error}}" class="error-note">{{error}}<button bindtap="load">重试</button></view>
  <button bindtap="createLink" loading="{{busy}}" disabled="{{busy}}">创建分享链接</button>
  <view class="card" wx:for="{{links}}" wx:key="id"><text>{{item.label || '分享链接'}}</text><text selectable>{{item.code}}</text><button size="mini" open-type="share" data-code="{{item.code}}">分享</button><button size="mini" data-code="{{item.code}}" bindtap="copyLink">复制码</button></view>
  <view class="card"><text class="title">申请提现</text><input type="digit" value="{{amountYuan}}" bindinput="amountInput" placeholder="金额（元）"/><button bindtap="withdraw" disabled="{{busy}}">提交申请</button><text class="hint">申请提交后仍需审核，到账请以提现记录为准。</text></view>
  <view class="card"><text class="title">账务记录</text><view wx:for="{{entries}}" wx:key="id"><text>{{item.eventType === 'FROZEN' ? '待结算' : item.eventType === 'SETTLED' ? '已结算' : item.eventType === 'REVERSED' ? '已撤销' : item.eventType === 'WITHDRAWAL_PAID' ? '已提现' : '提现处理中'}} · ¥{{item.amountMinor / 100}}</text></view><text wx:if="{{!entries.length}}">暂无记录</text></view>
  <view class="card"><text class="title">提现记录</text><view wx:for="{{withdrawals}}" wx:key="id"><text>{{item.status === 'REQUESTED' ? '审核中' : item.status === 'APPROVED' ? '已批准' : item.status === 'PAID' ? '已到账' : item.status === 'REJECTED' ? '未通过' : '已取消'}} · ¥{{item.amountMinor / 100}}</text></view><text wx:if="{{!withdrawals.length}}">暂无申请</text></view>
  </block>
</view>
