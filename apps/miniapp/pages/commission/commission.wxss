.commission-overview {
  padding: 30rpx;
  border-radius: 25rpx;
  background: #e8eff5;
}
.commission-overview .page-heading {
  margin: 0 0 25rpx;
}
.balance-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}
.balance-row view {
  flex: 1;
}
.balance-label,
.balance-value {
  display: block;
}
.balance-label {
  color: #718294;
  font-size: 22rpx;
}
.balance-value {
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 800;
}
.card {
  margin-top: 22rpx;
  min-height: auto;
}
.card .title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}
.card input {
  width: 100%;
  margin: 14rpx 0;
}
.hint {
  display: block;
  color: #75818d;
  font-size: 21rpx;
  line-height: 1.5;
}
