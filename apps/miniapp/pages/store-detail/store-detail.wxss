.detail-map {
  width: 100%;
  height: 420rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.detail-card {
  display: block;
}

.detail-row + .detail-row {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #eee7dc;
}

.detail-label {
  display: block;
  margin-bottom: 10rpx;
  color: #8a857b;
  font-size: 22rpx;
}

.detail-value {
  color: #343833;
  font-size: 27rpx;
  line-height: 1.6;
}

.service-chips {
  margin-top: 0;
}

.action-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 26rpx;
}

.action-btn {
  width: 100%;
  margin: 0;
}

.secondary-btn {
  border-radius: 18rpx;
  border: 1rpx solid #cfd9d1;
  background: #fff;
  color: #315d45;
  font-size: 26rpx;
  font-weight: 700;
}
.detail-map {
  margin: 18rpx 0 24rpx;
}
.action-row {
  margin-top: 22rpx;
}

.inventory-panel {
  padding: 28rpx;
}

.inventory-help {
  display: block;
  margin: 12rpx 0 20rpx;
  line-height: 1.6;
}

.inventory-search-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
  margin-bottom: 20rpx;
}

.inventory-query {
  flex: 1;
  min-width: 0;
  padding: 18rpx;
  border: 1rpx solid #d9e1da;
  border-radius: 12rpx;
  background: #fff;
  font-size: 26rpx;
}

.inventory-search-btn {
  margin: 0;
  color: #fff;
  background: #315d45;
}

.store-book-list {
  display: grid;
  gap: 14rpx;
}

.store-book-card {
  display: grid;
  gap: 8rpx;
  padding: 20rpx;
  border: 1rpx solid #eee7dc;
  border-radius: 16rpx;
  background: #fff;
}

.store-book-title {
  color: #293d32;
  font-size: 28rpx;
  font-weight: 700;
}

.store-book-footer {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 6rpx;
}

.store-book-footer button {
  margin: 0 0 0 auto;
}

.stock-label {
  color: #315d45;
  font-size: 24rpx;
}
