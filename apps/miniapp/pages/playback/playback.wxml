<view class="page playback-page">
  <view wx:if="{{loading}}" class="state-card">正在准备播放…</view>
  <view wx:elif="{{access}}">
    <view wx:if="{{access.access === 'LOCKED'}}" class="locked"><text class="state-title">暂时无法观看</text><text class="state-copy">该内容需要观看权益。</text></view>
    <video wx:else id="player" class="player" src="{{access.playbackUrl}}" initial-time="{{access.resumePositionSeconds}}" controls bindtimeupdate="time" bindended="ended" binderror="playbackError" />
    <view wx:if="{{access.access === 'PREVIEW'}}" class="preview-note">试看 {{access.previewSeconds}} 秒</view>
  </view>
  <view wx:if="{{error}}" class="state-card"><text class="state-copy">{{error}}</text><button bindtap="retry">重试</button></view>
</view>
