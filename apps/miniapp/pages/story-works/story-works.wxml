<view class="page">
  <view class="section-head">
    <text class="section-title">我的故事</text>
    <button class="small-btn" bindtap="createStory">新建</button>
  </view>

  <view wx:if="{{loading}}" class="state-card">
    <text class="state-title">正在加载作品</text>
  </view>

  <view wx:elif="{{error}}" class="state-card">
    <text class="state-title">加载失败</text>
    <text class="state-copy">请确认已经登录，并检查网络与后端服务。</text>
    <button class="primary-btn" bindtap="retry">重新加载</button>
  </view>

  <view wx:elif="{{works.length === 0}}" class="state-card">
    <text class="state-title">还没有故事作品</text>
    <text class="state-copy">从一个简单的故事想法开始吧。</text>
    <button class="primary-btn" bindtap="createStory">创作第一个故事</button>
  </view>

  <view wx:else class="work-list">
    <view
      wx:for="{{works}}"
      wx:key="id"
      class="list-card"
      data-id="{{item.id}}"
      bindtap="openWork"
    >
      <view class="list-main">
        <text class="list-title">{{item.title}}</text>
        <text class="list-meta">{{item.controls.theme}} · {{item.controls.ageRange}}</text>
        <text class="list-meta">{{item.controls.style}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>
</view>
