<view class="page">
  <text class="page-heading">小海商城</text>
  <view class="commerce-toolbar">
    <input placeholder="搜索商品、书名、作者或 ISBN" value="{{q}}" bindinput="onInput" confirm-type="search" bindconfirm="search" />
    <button bindtap="search">搜索</button>
    <button bindtap="cart">购物车</button>
  </view>
  <view wx:if="{{loading}}" class="state-card"><text class="state-title">正在加载商品…</text></view>
  <view wx:elif="{{error}}" class="state-card"><text class="state-title">商品暂时无法加载</text><button bindtap="search">重试</button></view>
  <view wx:elif="{{products.length===0}}" class="state-card"><text class="state-title">暂时没有找到商品</text><text class="state-copy">换个商品名称或关键字试试。</text></view>
  <view wx:else class="commerce-list">
    <view class="list-card" wx:for="{{products}}" wx:key="id" data-id="{{item.id}}" bindtap="open">
      <image wx:if="{{item.displayCoverUrl}}" class="book-cover" src="{{item.displayCoverUrl}}" mode="aspectFill" data-index="{{index}}" data-id="{{item.id}}" data-src="{{item.displayCoverUrl}}" binderror="coverError" />
      <view wx:else class="book-cover book-cover-placeholder">暂无封面</view>
      <view class="list-main"><text class="list-title">{{item.title || item.name}}</text><text class="list-meta">{{item.displaySubtitle}}</text><text class="price">{{item.displayPriceText}}</text></view>
      <text class="arrow">›</text>
    </view>
  </view>
</view>
