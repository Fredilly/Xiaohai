<view class="page"><view class="section"><input placeholder="书名 / 作者 / ISBN" value="{{q}}" bindinput="onInput"/><button size="mini" bindtap="search">搜索</button><button size="mini" bindtap="cart">购物车</button></view><view wx:if="{{loading}}" class="state-card">商城加载中…</view><view wx:elif="{{error}}" class="state-card">加载失败<button bindtap="search">重试</button></view><view wx:elif="{{products.length===0}}" class="state-card">暂无可售商品</view><view wx:else class="section"><view class="list-card" wx:for="{{products}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view class="list-main"><text class="list-title">{{item.title || item.name}}</text><text class="list-meta">{{item.author || ''}} · {{item.publisher || ''}}</text></view><text class="price">¥{{item.skus[0].priceMinor / 100}}</text></view></view></view>
