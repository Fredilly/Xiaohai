page {
  background: #f7f4ed;
  color: #2c302c;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}
.page {
  padding: 28rpx 28rpx 60rpx;
}
.hero {
  padding: 36rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #315d45, #66806e);
  color: #fff;
  margin-bottom: 26rpx;
}
.hero-soft {
  background: linear-gradient(135deg, #f2e2bd, #e7cda2);
  color: #3c352b;
}
.hero-title {
  font-size: 46rpx;
  font-weight: 800;
  display: block;
  margin: 12rpx 0;
}
.hero-subtitle {
  font-size: 26rpx;
  line-height: 1.7;
  opacity: 0.9;
}
.eyebrow {
  font-size: 21rpx;
  letter-spacing: 3rpx;
  font-weight: 700;
  opacity: 0.82;
}
.section {
  margin-top: 30rpx;
}
.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 800;
}
.section-note {
  font-size: 22rpx;
  color: #8b877e;
}
.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}
.card,
.list-card,
.profile-card,
.state-card {
  background: #fff;
  border: 1rpx solid #ebe5da;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(55, 45, 30, 0.04);
}
.card {
  min-height: 190rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: 800;
  display: block;
  margin-bottom: 10rpx;
}
.card-subtitle,
.muted {
  font-size: 23rpx;
  color: #7d796f;
  line-height: 1.6;
}
.badge {
  display: inline-flex;
  margin-top: 18rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #edf3ee;
  color: #315d45;
  font-size: 20rpx;
  font-weight: 700;
}
.book-list,
.store-list,
.menu-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.list-card {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}
.list-main {
  flex: 1;
}
.list-title {
  font-size: 28rpx;
  font-weight: 800;
  display: block;
}
.list-meta {
  font-size: 22rpx;
  color: #817d74;
  display: block;
  margin-top: 8rpx;
}
.price {
  font-size: 27rpx;
  font-weight: 800;
  color: #9a5b35;
}
.demo-note {
  margin: 20rpx 0;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #fff6df;
  color: #7c6233;
  font-size: 22rpx;
  line-height: 1.6;
}
.profile-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background: #315d45;
  color: #fff;
  display: grid;
  place-items: center;
  font-size: 36rpx;
  font-weight: 800;
}
.profile-main {
  flex: 1;
}
.profile-title {
  font-size: 30rpx;
  font-weight: 800;
  display: block;
}
.profile-status {
  font-size: 22rpx;
  color: #77736b;
  margin-top: 6rpx;
  display: block;
}
.primary-btn {
  margin: 22rpx 0 0;
  border: 0;
  border-radius: 18rpx;
  background: #315d45;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
}
.primary-btn[disabled] {
  opacity: 0.55;
}
.menu-row {
  background: #fff;
  border: 1rpx solid #ebe5da;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.menu-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.menu-title {
  font-size: 27rpx;
  font-weight: 700;
}
.menu-subtitle {
  font-size: 21rpx;
  color: #8b877e;
}
.arrow {
  color: #9b978e;
}
.state-card {
  margin-top: 22rpx;
  text-align: center;
  padding: 44rpx 26rpx;
}
.state-title {
  font-size: 30rpx;
  font-weight: 800;
  display: block;
}
.state-copy {
  font-size: 23rpx;
  color: #7d796f;
  line-height: 1.7;
  display: block;
  margin-top: 12rpx;
}
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}
.chip {
  padding: 12rpx 16rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 1rpx solid #e7e0d4;
  font-size: 22rpx;
  color: #5f625e;
}

/* Consumer UI foundations shared by detail pages. */
page {
  background: #f7f8fa;
  color: #35404b;
}
.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 28rpx 80rpx;
}
.hero {
  background: #e9eff5;
  color: #35404b;
  box-shadow: none;
  border-radius: 26rpx;
}
.hero-soft {
  background: #e9eff5;
  color: #35404b;
}
.hero-title {
  font-size: 40rpx;
  line-height: 1.35;
}
.hero-subtitle {
  color: #647481;
  opacity: 1;
}
.eyebrow {
  color: #778b9c;
}
.section-title {
  font-size: 31rpx;
  color: #35404b;
}
.card-title {
  color: #35404b;
}
.section-note,
.list-meta,
.muted,
.state-copy,
.card-subtitle {
  color: #75818d;
}
.card,
.list-card,
.profile-card,
.state-card {
  border: 1rpx solid #edf0f2;
  border-radius: 24rpx;
  box-shadow: 0 7rpx 22rpx rgba(54, 68, 84, 0.035);
}
.list-card:active,
.menu-row:active {
  opacity: 0.78;
}
.primary-btn {
  min-height: 80rpx;
  line-height: 80rpx;
  border-radius: 19rpx;
  background: #718da0;
  color: #fff;
  font-size: 26rpx;
}
.primary-btn:active,
button:active {
  opacity: 0.78;
}
.primary-btn[disabled],
button[disabled] {
  opacity: 0.52;
}
input,
textarea {
  box-sizing: border-box;
  min-height: 72rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #e8edf1;
  border-radius: 16rpx;
  background: #f9fafb;
  color: #35404b;
  font-size: 25rpx;
}
textarea {
  width: 100%;
  min-height: 160rpx;
}
.state-card {
  padding: 44rpx 28rpx;
  background: #fff;
}
.state-title {
  color: #35404b;
}
.demo-note,
.error-note {
  background: #fff4ed;
  border-radius: 18rpx;
  padding: 17rpx 20rpx;
  color: #9b6856;
  line-height: 1.55;
}
.badge {
  background: #edf2f6;
  color: #657d90;
  border-radius: 999rpx;
}
.page.pangzhu {
  color: #354640;
}
.pangzhu .hero,
.pangzhu .hero-soft {
  background: #e7f0e8;
  color: #354640;
}
.pangzhu .primary-btn {
  background: #769782;
}
.pangzhu .badge {
  background: #e9f2e9;
  color: #577361;
}
.pangzhu .section-title,
.pangzhu .card-title {
  color: #354640;
}
.pangzhu input,
.pangzhu textarea {
  background: #f7faf7;
  border-color: #e4ece5;
}
/* Lists use real content and clear hierarchy, not nested grids. */
.reader-list .list-card,
.commerce-list .list-card {
  align-items: center;
  margin-bottom: 14rpx;
  background: #fff;
}
.reader-list .list-main,
.commerce-list .list-main {
  min-width: 0;
}
.reader-list .list-title,
.commerce-list .list-title {
  line-height: 1.4;
}
.reader-list .list-meta,
.commerce-list .list-meta {
  line-height: 1.45;
}
.book-cover {
  flex: none;
  width: 112rpx;
  height: 150rpx;
  border-radius: 11rpx;
  background: #e9edf1;
}
.book-cover-placeholder {
  display: flex;
  justify-content: center;
  align-items: center;
  color: #8d9da9;
  font-size: 21rpx;
  background: #edf1f4;
}
.commerce-toolbar,
.search-toolbar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.commerce-toolbar input,
.search-toolbar input {
  flex: 1;
  min-width: 0;
}
.commerce-toolbar button,
.search-toolbar button {
  margin: 0;
  flex: none;
  border-radius: 17rpx;
  font-size: 23rpx;
}
.page-heading {
  display: block;
  margin: 6rpx 0 24rpx;
  font-size: 39rpx;
  font-weight: 800;
  line-height: 1.3;
}
.state-pill {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  color: #607f91;
  background: #ebf2f6;
  font-size: 21rpx;
}
.state-pill.pending {
  color: #9b7657;
  background: #fff3e4;
}
.state-pill.failed {
  color: #a35f63;
  background: #f9eaeb;
}
.bottom-action {
  position: sticky;
  bottom: 0;
  z-index: 3;
  margin: 25rpx -28rpx -80rpx;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.97);
  border-top: 1rpx solid #eef0f2;
}
.bottom-action .primary-btn {
  margin-top: 12rpx;
}
