# 预发布环境仅使用密钥管理系统注入的真实值。
# Inject real staging values through the secret manager only.
NODE_ENV=production
APP_ENV=staging
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://STAGING_USER:STAGING_PASSWORD@STAGING_HOST:5432/STAGING_DATABASE
REDIS_URL=redis://STAGING_REDIS_HOST:6379
AI_PROVIDER=DEEPSEEK
AI_MOCK_ENABLED=false
DEEPSEEK_API_KEY=INJECT_FROM_STAGING_SECRET_MANAGER
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_WORKER_POLL_MS=1000
STORY_AI_ENABLED=false
STORY_AI_PROVIDER=DEEPSEEK
STORY_AI_MODEL=INJECT_APPROVED_STORY_MODEL
STORY_AI_MAX_ATTEMPTS=3
STORY_AI_TIMEOUT_MS=30000
WECHAT_APP_ID=INJECT_FROM_STAGING_SECRET_MANAGER
WECHAT_APP_SECRET=INJECT_FROM_STAGING_SECRET_MANAGER
WECHAT_AUTH_TIMEOUT_MS=5000
CONSUMER_SESSION_SECRET=INJECT_FROM_STAGING_SECRET_MANAGER_MINIMUM_32_CHARACTERS
CONSUMER_SESSION_TTL_SECONDS=604800
STAFF_SESSION_SECRET=INJECT_DISTINCT_STAGING_SECRET_MANAGER_VALUE_MINIMUM_32_CHARACTERS
STAFF_SESSION_TTL_SECONDS=28800
VITE_API_BASE_URL=https://STAGING_API_DOMAIN
WECHAT_PAY_ENABLED=false
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_SERIAL=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_KEY_ID=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
WECHAT_PAY_NOTIFY_URL=https://staging-payments.example.invalid/api/v1/payments/wechat/notify
WECHAT_PAY_REFUND_NOTIFY_URL=https://staging-payments.example.invalid/api/v1/payments/wechat/notify
