# 开发环境安全占位值；复制为 .env 后仅在本地修改。
# Safe development placeholders; copy to .env and modify locally only.
NODE_ENV=development
APP_ENV=dev
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://xiaohai:xiaohai_dev_only@127.0.0.1:5432/xiaohai_dev
REDIS_URL=redis://127.0.0.1:6379
AI_PROVIDER=MOCK
AI_MOCK_ENABLED=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_WORKER_POLL_MS=1000
STORY_AI_ENABLED=false
STORY_AI_PROVIDER=MOCK
STORY_AI_MODEL=mock-story-v1
STORY_AI_MAX_ATTEMPTS=3
STORY_AI_TIMEOUT_MS=30000
WECHAT_APP_ID=replace-with-local-miniapp-app-id
WECHAT_APP_SECRET=replace-with-local-secret
WECHAT_AUTH_TIMEOUT_MS=5000
CONSUMER_SESSION_SECRET=replace-with-at-least-32-random-characters
CONSUMER_SESSION_TTL_SECONDS=604800
STAFF_SESSION_SECRET=replace-with-a-different-32-character-random-secret
STAFF_SESSION_TTL_SECONDS=28800
VITE_API_BASE_URL=http://127.0.0.1:3000
WECHAT_PAY_ENABLED=false
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_SERIAL=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_KEY_ID=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
WECHAT_PAY_NOTIFY_URL=https://payments.example.invalid/api/v1/payments/wechat/notify
WECHAT_PAY_REFUND_NOTIFY_URL=https://payments.example.invalid/api/v1/payments/wechat/notify
