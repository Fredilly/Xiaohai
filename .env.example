# 开发环境安全占位值；复制为 .env 后仅在本地修改。
# Safe development placeholders; copy to .env and modify locally only.
NODE_ENV=development
APP_ENV=dev
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://xiaohai:xiaohai_dev_only@127.0.0.1:5432/xiaohai_dev
WECHAT_APP_ID=replace-with-local-miniapp-app-id
WECHAT_APP_SECRET=replace-with-local-secret
WECHAT_AUTH_TIMEOUT_MS=5000
CONSUMER_SESSION_SECRET=replace-with-at-least-32-random-characters
CONSUMER_SESSION_TTL_SECONDS=604800
