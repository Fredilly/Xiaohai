{
  "name": "xiaohai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22 <23 || >=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:local": "node scripts/dev-local.mjs",
    "benchmark:story": "pnpm --filter @xiaohai/worker exec tsx ../../benchmarks/story/cli.ts",
    "benchmark:image": "pnpm --filter @xiaohai/worker exec tsx ../../benchmarks/image/cli.ts",
    "benchmark:image:finalize": "node benchmarks/image/finalize.mjs",
    "secret:set": "node scripts/set-local-secret.mjs",
    "seed:local-staff": "pnpm --filter @xiaohai/api seed:local-staff",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @xiaohai/api test:integration && pnpm --filter @xiaohai/worker test:integration",
    "test:e2e": "playwright test",
    "test:inventory-web": "playwright test --config playwright.inventory.config.ts",
    "check:workspace": "node scripts/check-workspace.mjs",
    "check:secrets": "node --test scripts/secret-policy.test.mjs scripts/set-local-secret.test.mjs && node scripts/check-secrets.mjs",
    "check:miniapp": "node scripts/check-miniapp.mjs",
    "check": "pnpm check:workspace && pnpm check:miniapp && pnpm check:secrets && pnpm test:preflight && pnpm test:picture-book-quality && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "preflight:image": "node --env-file-if-exists .env scripts/image-preflight.mjs",
    "preflight:i111-readonly": "node scripts/i111-readonly-runtime-preflight.mjs",
    "test:i111-readonly-integration": "node --test scripts/i111-readonly-runtime-preflight.integration.test.mjs",
    "test:i111-exclusive-lock-integration": "I111_EXCLUSIVE_LOCK_PG_TEST_REQUIRED=1 node --test scripts/i111-exclusive-pg-lock.integration.test.mjs",
    "i111:trusted-runner": "pnpm --filter @xiaohai/api exec tsx ../../scripts/i111-trusted-one-shot-runner.mjs",
    "test:i111-trusted-runner": "node --test scripts/i111-trusted-one-shot-runner.test.mjs",
    "test:preflight": "node --test scripts/local-startup.test.mjs scripts/image-preflight.test.mjs scripts/i111-build-attestation.test.mjs scripts/i111-db-evidence-ports.test.mjs scripts/i111-exclusive-pg-lock.test.mjs scripts/i111-runtime-surface.test.mjs scripts/i111-one-shot-policy.test.mjs scripts/i111-one-shot-orchestration.test.mjs scripts/i111-paid-operation-grant.test.mjs scripts/i111-trusted-one-shot-runner.test.mjs scripts/i111-readonly-runtime-preflight.test.mjs scripts/i111-reviewed-control-ports.test.mjs scripts/release-preflight.test.mjs scripts/private-bos-staging-smoke.test.mjs scripts/production-web-preflight.test.mjs",
    "preflight:private-bos": "node --env-file-if-exists .env scripts/private-bos-staging-smoke.mjs",
    "test:picture-book-quality": "node --test benchmarks/picture-book-quality/review.test.mjs",
    "preflight:release": "node --env-file-if-exists .env scripts/release-preflight.mjs",
    "preflight:production-web": "node scripts/production-web-preflight.mjs",
    "preflight:production-unified": "node scripts/production-unified-preflight.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
