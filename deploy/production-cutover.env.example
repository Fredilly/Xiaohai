# Template ONLY. Merge reviewed values into the ignored production.env on the
# trusted Mac/host; never overwrite an existing secret file or commit secrets.
# This cold-cutover profile must never run while Staging ingress is active.
APP_ENV=production
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
POSTGRES_DB=xiaohai_production
POSTGRES_USER=xiaohai_production_user
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_32_PLUS_CHARACTER_SECRET
DATABASE_URL=postgresql://xiaohai_production_user:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/xiaohai_production
REDIS_URL=redis://redis:6379

# Review these exact immutable GHCR digests against the approved release.
API_REVISION=REPLACE_WITH_REVIEWED_40_CHARACTER_SHA
WEB_REVISION=REPLACE_WITH_SAME_REVIEWED_40_CHARACTER_SHA
API_IMAGE_DIGEST=REPLACE_WITH_REVIEWED_SHA256_DIGEST
WORKER_IMAGE_DIGEST=REPLACE_WITH_REVIEWED_SHA256_DIGEST
WEB_IMAGE_DIGEST=REPLACE_WITH_REVIEWED_SHA256_DIGEST

# Limits require measured single-host evidence, not a guessed allowance.
PRODUCTION_POSTGRES_MEM_LIMIT=REPLACE_WITH_REVIEWED_LIMIT
PRODUCTION_REDIS_MEM_LIMIT=REPLACE_WITH_REVIEWED_LIMIT
PRODUCTION_API_MEM_LIMIT=REPLACE_WITH_REVIEWED_LIMIT
PRODUCTION_WORKER_MEM_LIMIT=REPLACE_WITH_REVIEWED_LIMIT
PRODUCTION_WEB_MEM_LIMIT=REPLACE_WITH_REVIEWED_LIMIT
PRODUCTION_EDGE_MEM_LIMIT=REPLACE_WITH_REVIEWED_LIMIT

# Evidence flags may only be changed after independent records exist.
CUTOVER_FINAL_APPROVED=false
CUTOVER_STAGING_STOP_APPROVED=false
CUTOVER_CAPACITY_EVIDENCE_VERIFIED=false
CUTOVER_BACKUP_RESTORE_VERIFIED=false
CUTOVER_ROLLBACK_EVIDENCE_VERIFIED=false
CUTOVER_INGRESS_EVIDENCE_VERIFIED=false

CONSUMER_SESSION_SECRET=REPLACE_WITH_UNIQUE_32_PLUS_CHARACTER_SECRET
STAFF_SESSION_SECRET=REPLACE_WITH_DIFFERENT_32_PLUS_CHARACTER_SECRET
PICKUP_CODE_SECRET=REPLACE_WITH_THIRD_32_PLUS_CHARACTER_SECRET
WECHAT_APP_ID=REPLACE_WITH_VERIFIED_COMPANY_APP_ID
WECHAT_APP_SECRET=REPLACE_WITH_PRODUCTION_WECHAT_SECRET
AI_PROVIDER=REPLACE_WITH_APPROVED_PROVIDER
AI_MOCK_ENABLED=false

# Limited initial launch. Never enable these by editing the template alone.
WECHAT_PAY_ENABLED=false
FOOD_STOCK_WRITES_ENABLED=false
FOOD_CHECKOUT_ENABLED=false
STORY_AI_ENABLED=false
PICTURE_BOOK_AI_ENABLED=false
PICTURE_BOOK_IMAGE_ENABLED=false
ANIMATION_AI_ENABLED=false
ANIMATION_VIDEO_ENABLED=false
ANIMATION_COMPOSITION_ENABLED=false
