# Template only: copy to ignored production.env on the trusted host; chmod 600.
# Never commit real credentials. Replace ALL placeholders before any use.
APP_ENV=production
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
POSTGRES_DB=xiaohai_production
POSTGRES_USER=xiaohai_production_user
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_32_PLUS_CHARACTER_SECRET
DATABASE_URL=postgresql://xiaohai_production_user:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/xiaohai_production
REDIS_URL=redis://redis:6379
WEB_REVISION=REPLACE_WITH_REVIEWED_40_CHARACTER_SHA
API_REVISION=REPLACE_WITH_REVIEWED_40_CHARACTER_SHA
# Set memory caps only after measured combined-host capacity review.
PRODUCTION_POSTGRES_MEM_LIMIT=REPLACE_WITH_REVIEWED_LIMIT
PRODUCTION_REDIS_MEM_LIMIT=REPLACE_WITH_REVIEWED_LIMIT
PRODUCTION_API_MEM_LIMIT=REPLACE_WITH_REVIEWED_LIMIT
PRODUCTION_WORKER_MEM_LIMIT=REPLACE_WITH_REVIEWED_LIMIT
PRODUCTION_WEB_MEM_LIMIT=REPLACE_WITH_REVIEWED_LIMIT
# Evidence acknowledgements: never set true solely to force a pass.
COHOST_ARCHITECTURE_APPROVED=false
COHOST_INGRESS_EVIDENCE_VERIFIED=false
COHOST_CAPACITY_EVIDENCE_VERIFIED=false
PRODUCTION_BACKUP_RESTORE_VERIFIED=false
# Distinct production-only app credentials; never reuse Staging.
CONSUMER_SESSION_SECRET=REPLACE_WITH_UNIQUE_32_PLUS_CHARACTER_SECRET
STAFF_SESSION_SECRET=REPLACE_WITH_DIFFERENT_32_PLUS_CHARACTER_SECRET
PICKUP_CODE_SECRET=REPLACE_WITH_THIRD_32_PLUS_CHARACTER_SECRET
WECHAT_APP_ID=REPLACE_WITH_VERIFIED_COMPANY_APP_ID
WECHAT_APP_SECRET=REPLACE_WITH_PRODUCTION_WECHAT_SECRET
# No live money, food stock movements, or paid AI before separate UAT.
WECHAT_PAY_ENABLED=false
FOOD_STOCK_WRITES_ENABLED=false
FOOD_CHECKOUT_ENABLED=false
STORY_AI_ENABLED=false
PICTURE_BOOK_AI_ENABLED=false
PICTURE_BOOK_IMAGE_ENABLED=false
ANIMATION_AI_ENABLED=false
ANIMATION_VIDEO_ENABLED=false
ANIMATION_COMPOSITION_ENABLED=false
